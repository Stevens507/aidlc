        </mxCell>
        <mxCell id="gm1b" parent="1" style="text;html=1;fontSize=10.5;fontColor=#53595F;align=left;verticalAlign=top;spacingTop=2;" value="Se cuenta en líneas de código cambiadas y ficheros tocados. Objetivo:&lt;div&gt;menos de 200 líneas y 10 ficheros (tope 400 y 20). Un PR enorme no se&amp;nbsp;&lt;/div&gt;&lt;div&gt;revisa: se aprueba a ciegas.&lt;/div&gt;" vertex="1">
          <mxGeometry height="56" width="366" x="60" y="770" as="geometry" />
        </mxCell>
