;fillColor=#FFFFFF;strokeColor=#CCCCCC;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="518" width="460" height="64" as="geometry" /></mxCell><mxCell id="H-Artefactos_n28" value="&lt;b style=&quot;font-size:11px&quot;&gt;3.5&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;&lt;b&gt;Plan aprobado &amp;#183; instrucciones de prueba &amp;#183; resumen del c&amp;#243;digo&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CCCCCC;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="592" width="460" height="64" as="geometry" /></mxCell><mxCell id="H-Artefactos_n29" value="&lt;b style=&quot;font-size:11px&quot;&gt;3.6&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;4 tipos de instrucciones de prueba &amp;#183; resultados&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CCCCCC;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="666" width="460" height="64" as="geometry" /></mxCell><mxCell id="H-Artefactos_n30" value="&lt;b style=&quot;font-size:11px&quot;&gt;4.1&amp;#8211;4.3&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Configuraci&amp;#243;n de despliegue &amp;#183; runbook de reversi&amp;#243;n &amp;#183; inventario de entornos &amp;#183; bit&amp;#225;cora &amp;#183; humo &amp;#183; salud&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CCCCCC;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="740" width="460" height="64" as="geometry" /></mxCell><mxCell id="H-Artefactos_n31" value="&lt;b style=&quot;font-size:11px&quot;&gt;4.4&amp;#8211;4.7&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Tableros &amp;#183; alarmas &amp;#183; objetivos de servicio &amp;#183; runbooks &amp;#183; matriz de escalamiento &amp;#183; carga &amp;#183; costo &amp;#183; deriva&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#CCCCCC;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="814" width="460" height="64" as="geometry" /></mxCell><mxCell id="H-Artefactos_n32" value="&lt;b&gt;La trazabilidad no es un documento: es un artefacto que producen 8 etapas&lt;/b&gt;&lt;br&gt;&lt;br&gt;El artefacto &lt;code&gt;traceability&lt;/code&gt; lo escriben &lt;b&gt;historias de usuario, dise&amp;#241;o de dominio, unidades, dise&amp;#241;o funcional, requisitos no funcionales, su dise&amp;#241;o, infraestructura y generaci&amp;#243;n de c&amp;#243;digo&lt;/b&gt;. En construcci&amp;#243;n hay adem&amp;#225;s una trazabilidad cruzada entre unidades.&lt;br&gt;&lt;br&gt;Esa es la cadena que se verifica en cada frontera de fase:&lt;br&gt;&lt;br&gt;&lt;b&gt;intenci&amp;#243;n &amp;#8594; alcance &amp;#8594; requisitos &amp;#8594; dise&amp;#241;os &amp;#8594; unidades &amp;#8594; c&amp;#243;digo &amp;#8594; pruebas &amp;#8594; despliegue&lt;/b&gt;&lt;br&gt;&lt;br&gt;Si un eslab&amp;#243;n falta, no se avanza. &lt;b&gt;Es lo que responde a un auditor cuando pregunta de qu&amp;#233; requisito sali&amp;#243; una l&amp;#237;nea de c&amp;#243;digo.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="60" y="1006" width="1040" height="250" as="geometry" /></mxCell><mxCell id="H-Artefactos_n33" value="&lt;b&gt;Un l&amp;#237;mite que conviene saber&lt;/b&gt;&lt;br&gt;&lt;br&gt;La cadena llega hasta el despliegue, pero &lt;b&gt;no hay vuelta atr&amp;#225;s desde un commit&lt;/b&gt;.&lt;br&gt;&lt;br&gt;v2 lo declara como &lt;i&gt;&amp;#171;pregunta de dise&amp;#241;o abierta&amp;#187;&lt;/i&gt;: no existe b&amp;#250;squeda inversa desde un commit arbitrario hasta su intenci&amp;#243;n y su workflow.&lt;br&gt;&lt;br&gt;Para banca y sector p&amp;#250;blico, eso no es un detalle menor." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1130" y="1006" width="520" height="250" as="geometry" /></mxCell><mxCell id="p9_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="128" width="1610" height="92" as="geometry" /></mxCell><mxCell id="p9_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="132" width="496" height="16" as="geometry" /></mxCell><mxCell id="p9_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p9_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p9_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p9_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p9_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p9_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p9_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="436" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p9_fr10" value="&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;&lt;b&gt;bolt&lt;/b&gt; = ciclo de horas o d&amp;#237;as, no de semanas &amp;#160;&amp;#183;&amp;#160; &lt;b&gt;unidad de trabajo&lt;/b&gt; = lo que antes era una &amp;#233;pica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="192" width="496" height="22" as="geometry" /></mxCell><mxCell id="p9_fr11" value="&lt;span style=&quot;font-size:9px;color:#888&quot;&gt;fontaner&amp;#237;a&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p9_fr12" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;INCEPTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="132" width="410" height="22" as="geometry" /></mxCell><mxCell id="p9_fr13" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;CONSTRUCTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p9_fr14" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;OPERATIONS&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p9_fr15" value="&lt;b style=&quot;font-size:11px&quot;&gt;0 &amp;#183; Inicializaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;3 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p9_fr16" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Ideaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p9_fr17" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Inception&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;9 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="988" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p9_fr18" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Construcci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p9_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p9_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="196" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="wf10" name="10 - Como se verifica y como aprende"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="L-Verificacion_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:23px&quot;&gt;C&amp;#243;mo se verifica lo producido, y c&amp;#243;mo el m&amp;#233;todo aprende&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Tres capas de verificaci&amp;#243;n con naturalezas distintas, m&amp;#225;s el bucle que convierte una correcci&amp;#243;n tuya en regla permanente.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1610" height="84" as="geometry" /></mxCell><mxCell id="L-Verificacion_n2" value="&lt;b style=&quot;font-size:13px&quot;&gt;CAPA 1 &amp;#183; SENSORES&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;verificaci&amp;#243;n determinista, dispara en cada escritura&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#8A8A8A;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="244" width="780" height="40" as="geometry" /></mxCell><mxCell id="L-Verificacion_n3" value="&lt;b style=&quot;font-size:11px&quot;&gt;claim-sources&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Toda afirmaci&amp;#243;n lleva etiqueta de fuente que resuelve al registro confirmado&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="780" height="50" as="geometry" /></mxCell><mxCell id="L-Verificacion_n4" value="&lt;b style=&quot;font-size:11px&quot;&gt;required-sections&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Los encabezados requeridos est&amp;#225;n. &lt;b&gt;Sin plantilla, solo comprueba que haya dos&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="780" height="50" as="geometry" /></mxCell><mxCell id="L-Verificacion_n5" value="&lt;b style=&quot;font-size:11px&quot;&gt;upstream-coverage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Los entregables referencian cada artefacto que la etapa declara consumir&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="408" width="780" height="50" as="geometry" /></mxCell><mxCell id="L-Verificacion_n6" value="&lt;b style=&quot;font-size:11px&quot;&gt;traceability&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;IDs upstream declarados y cubiertos, destinos downstream existentes&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="466" width="780" height="50" as="geometry" /></mxCell><mxCell id="L-Verificacion_n7" value="&lt;b style=&quot;font-size:11px&quot;&gt;linter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Envuelve el linter del proyecto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="524" width="780" height="50" as="geometry" /></mxCell><mxCell id="L-Verificacion_n8" value="&lt;b style=&quot;font-size:11px&quot;&gt;type-check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Envuelve el verificador de tipos del proyecto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="582" width="780" height="50" as="geometry" /></mxCell><mxCell id="L-Verificacion_n9" value="&lt;b&gt;El l&amp;#237;mite que hay que declarar:&lt;/b&gt; los seis son &lt;b&gt;advisory&lt;/b&gt;. El esquema acepta hoy un solo valor de severidad; &lt;b&gt;blocking&lt;/b&gt; est&amp;#225; reservado (issue #431). Un sensor que falla deja constancia y un archivo de detalle, &lt;b&gt;pero no detiene la compuerta.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="60" y="646" width="780" height="92" as="geometry" /></mxCell><mxCell id="L-Verificacion_n10" value="&lt;b style=&quot;font-size:13px&quot;&gt;CAPA 2 &amp;#183; REVISOR&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;verificaci&amp;#243;n inferencial, con salvaguardas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#8A8A8A;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="875" y="244" width="780" height="40" as="geometry" /></mxCell><mxCell id="L-Verificacion_n11" value="&lt;b&gt;Se despacha como agente aparte&lt;/b&gt; y recibe la definici&amp;#243;n de la etapa, las preguntas y los artefactos &amp;#8212; &lt;b&gt;nunca el diario ni el plan de quien lo construy&amp;#243;&lt;/b&gt;, para que forme juicio propio.&lt;br&gt;Escribe una sola secci&amp;#243;n de revisi&amp;#243;n con un solo veredicto: &lt;b&gt;LISTO&lt;/b&gt; o &lt;b&gt;NO LISTO&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;" vertex="1" parent="1"><mxGeometry x="875" y="292" width="780" height="116" as="geometry" /></mxCell><mxCell id="L-Verificacion_n12" value="&lt;b&gt;ADVISORY&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;las etapas de prosa&lt;/span&gt;&lt;br&gt;&lt;br&gt;Una sola pasada, y &lt;b&gt;ambos veredictos son terminales&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Los hallazgos se citan textualmente en la compuerta, ordenados por severidad. &lt;b&gt;T&amp;#250; tr&amp;#237;as.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;" vertex="1" parent="1"><mxGeometry x="875" y="420" width="380" height="172" as="geometry" /></mxCell><mxCell id="L-Verificacion_n13" value="&lt;b&gt;ADVERSARIAL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;las etapas de dise&amp;#241;o y construcci&amp;#243;n&lt;/span&gt;&lt;br&gt;&lt;br&gt;El revisor &lt;b&gt;intenta refutar&lt;/b&gt; el artefacto, no confirmarlo.&lt;br&gt;&lt;br&gt;&lt;b&gt;LISTO es el veredicto al que falla en llegar&lt;/b&gt;, no el punto de partida. Si dice que no, se repara y se re-revisa, hasta dos veces." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#C9821F;" vertex="1" parent="1"><mxGeometry x="1275" y="420" width="380" height="172" as="geometry" /></mxCell><mxCell id="L-Verificacion_n14" value="&lt;b&gt;Las salvaguardas que lo hacen fiable&lt;/b&gt;&lt;br&gt;&amp;#183;&amp;#160;Presupuesto duro de &lt;b&gt;60 turnos&lt;/b&gt; por revisi&amp;#243;n&lt;br&gt;&amp;#183;&amp;#160;Se &lt;b&gt;borra la revisi&amp;#243;n anterior antes de cada despacho&lt;/b&gt;, para que un &amp;#171;listo&amp;#187; viejo no se lea como nuevo&lt;br&gt;&amp;#183;&amp;#160;&lt;b&gt;Un veredicto solo cuenta si parsea.&lt;/b&gt; Si el revisor se corta, se reintenta una vez; a la segunda se registra &lt;b&gt;NO LISTO&lt;/b&gt; con el hallazgo &amp;#171;la revisi&amp;#243;n no termin&amp;#243;&amp;#187;&lt;br&gt;&amp;#183;&amp;#160;Tras el recibo final, &lt;b&gt;tocar el artefacto invalida la revisi&amp;#243;n&lt;/b&gt; y el motor rechaza la compuerta" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="875" y="604" width="780" height="134" as="geometry" /></mxCell><mxCell id="L-Verificacion_n15" value="&lt;b style=&quot;font-size:13px&quot;&gt;CAPA 3 &amp;#183; TRAZABILIDAD&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;se verifica en cada frontera de fase&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#8A8A8A;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="758" width="780" height="40" as="geometry" /></mxCell><mxCell id="L-Verificacion_n16" value="&lt;b&gt;No es prosa: son identificadores estables con prefijo fijo&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;FR1&lt;/code&gt;, &lt;code&gt;FR1.2&lt;/code&gt; &amp;#8212; requisito funcional&lt;br&gt;&lt;code&gt;NFR2&lt;/code&gt; &amp;#8212; requisito no funcional&lt;br&gt;&lt;code&gt;US1.3&lt;/code&gt; &amp;#8212; historia de usuario&lt;br&gt;&lt;code&gt;AC1.3.2&lt;/code&gt; &amp;#8212; criterio de aceptaci&amp;#243;n&lt;br&gt;&lt;code&gt;U1&lt;/code&gt; &amp;#8212; unidad de trabajo&lt;br&gt;&lt;code&gt;BR1.1&lt;/code&gt; &amp;#8212; regla de negocio&lt;br&gt;&lt;br&gt;Ocho etapas escriben un archivo de trazabilidad con dos miradas:&lt;br&gt;&amp;#160;&amp;#160;&lt;b&gt;cobertura&lt;/b&gt; &amp;#8212; qu&amp;#233; de lo anterior qued&amp;#243; cubierto (mira hacia arriba)&lt;br&gt;&amp;#160;&amp;#160;&lt;b&gt;inversa&lt;/b&gt; &amp;#8212; qu&amp;#233; de esto no viene de nada (mira hacia abajo)&lt;br&gt;&lt;br&gt;&lt;b&gt;Es lo que responde a un auditor&lt;/b&gt; cuando pregunta de qu&amp;#233; requisito sali&amp;#243; una l&amp;#237;nea de c&amp;#243;digo." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="60" y="806" width="780" height="300" as="geometry" /></mxCell><mxCell id="L-Verificacion_n17" value="&lt;b style=&quot;font-size:13px&quot;&gt;EL BUCLE DE APRENDIZAJE&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;corre antes de cada compuerta&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#8A8A8A;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="875" y="758" width="780" height="40" as="geometry" /></mxCell><mxCell id="L-Verificacion_n18" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Diario&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Mientras la etapa corre, el agente anota bajo cuatro encabezados: &lt;b&gt;qu&amp;#233; interpret&amp;#243;, en qu&amp;#233; se desvi&amp;#243;, qu&amp;#233; descart&amp;#243;, qu&amp;#233; queda por confirmar&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="875" y="806" width="780" height="54" as="geometry" /></mxCell><mxCell id="L-Verificacion_n19" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Aflorar&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Una herramienta lee el diario y presenta cada l&amp;#237;nea &lt;b&gt;textualmente&lt;/b&gt;. Sin par&amp;#225;frasis, sin filtrar por &amp;#171;interesante&amp;#187;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="875" y="868" width="780" height="54" as="geometry" /></mxCell><mxCell id="L-Verificacion_n20" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Confirmar&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;T&amp;#250; marcas qu&amp;#233; conservar. &lt;b&gt;Siempre se pregunta &amp;#171;&amp;#191;algo que a&amp;#241;adir?&amp;#187;&lt;/b&gt; aunque no haya candidatos &amp;#8212; nunca se infiere que no&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="875" y="930" width="780" height="54" as="geometry" /></mxCell><mxCell id="L-Verificacion_n21" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Admisi&amp;#243;n&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Se compara contra la regla de la organizaci&amp;#243;n. Si contradice: &lt;b&gt;revisar, saltar o escalar. Sin override&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="875" y="992" width="780" height="54" as="geometry" /></mxCell><mxCell id="L-Verificacion_n22" value="&lt;b style=&quot;font-size:11px&quot;&gt;5 &amp;#183; Persistir&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Se escribe como pr&amp;#225;ctica. Por defecto en el proyecto; un clic lo promueve al equipo. &lt;b&gt;Nunca a la capa de la organizaci&amp;#243;n&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;verticalAlign=middle;spacing=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="875" y="1054" width="780" height="54" as="geometry" /></mxCell><mxCell id="L-Verificacion_n23" value="&lt;b&gt;El &amp;#250;nico trabajo que hace el modelo en este bucle es escribir el diario.&lt;/b&gt; Aflorar, rutear y escribir lo hace herramienta determinista o tu elecci&amp;#243;n expl&amp;#237;cita." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="875" y="1118" width="780" height="66" as="geometry" /></mxCell><mxCell id="L-Verificacion_n24" value="&lt;b style=&quot;font-size:13px&quot;&gt;Y AL CERRAR&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;tres comandos que se invocan cuando hacen falta&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#8A8A8A;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="1126" width="780" height="40" as="geometry" /></mxCell><mxCell id="L-Verificacion_n25" value="&lt;b style=&quot;font-size:11px&quot;&gt;Pack de resultados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Un &lt;b&gt;documento &amp;#250;nico de traspaso&lt;/b&gt;: todo lo que el equipo necesita para operar y seguir construyendo &lt;b&gt;sin re-correr el workflow&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;verticalAlign=middle;spacing=6;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="60" y="1174" width="780" height="58" as="geometry" /></mxCell><mxCell id="L-Verificacion_n26" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Box_Open.svg;" vertex="1" parent="1"><mxGeometry x="72" y="1188" width="22" height="22" as="geometry" /></mxCell><mxCell id="L-Verificacion_n27" value="&lt;b style=&quot;font-size:11px&quot;&gt;Repetici&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;El rastro de auditor&amp;#237;a convertido en &lt;b&gt;historia legible&lt;/b&gt;: qu&amp;#233; se decidi&amp;#243;, en qu&amp;#233; orden y por qu&amp;#233;. Para revisi&amp;#243;n as&amp;#237;ncrona&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;verticalAlign=middle;spacing=6;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="60" y="1240" width="780" height="58" as="geometry" /></mxCell><mxCell id="L-Verificacion_n28" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Book_Open.svg;" vertex="1" parent="1"><mxGeometry x="72" y="1254" width="22" height="22" as="geometry" /></mxCell><mxCell id="L-Verificacion_n29" value="&lt;b style=&quot;font-size:11px&quot;&gt;Costo de la sesi&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Duraci&amp;#243;n, compuertas superadas, sensores disparados, aprendizajes capturados. &lt;b&gt;No estima nada: si un n&amp;#250;mero no est&amp;#225; en la herramienta, no lo inventa&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;verticalAlign=middle;spacing=6;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="60" y="1306" width="780" height="58" as="geometry" /></mxCell><mxCell id="L-Verificacion_n30" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Chart_Simple.svg;" vertex="1" parent="1"><mxGeometry x="72" y="1320" width="22" height="22" as="geometry" /></mxCell><mxCell id="p10_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="128" width="1610" height="92" as="geometry" /></mxCell><mxCell id="p10_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="132" width="496" height="16" as="geometry" /></mxCell><mxCell id="p10_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p10_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p10_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p10_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p10_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p10_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p10_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="436" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p10_fr10" value="&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;&lt;b&gt;bolt&lt;/b&gt; = ciclo de horas o d&amp;#237;as, no de semanas &amp;#160;&amp;#183;&amp;#160; &lt;b&gt;unidad de trabajo&lt;/b&gt; = lo que antes era una &amp;#233;pica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="192" width="496" height="22" as="geometry" /></mxCell><mxCell id="p10_fr11" value="&lt;span style=&quot;font-size:9px;color:#888&quot;&gt;fontaner&amp;#237;a&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p10_fr12" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;INCEPTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="132" width="410" height="22" as="geometry" /></mxCell><mxCell id="p10_fr13" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;CONSTRUCTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p10_fr14" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;OPERATIONS&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p10_fr15" value="&lt;b style=&quot;font-size:11px&quot;&gt;0 &amp;#183; Inicializaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;3 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p10_fr16" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Ideaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p10_fr17" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Inception&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;9 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="988" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p10_fr18" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Construcci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p10_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p10_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="196" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="wf11" name="11 - Como se adapta a tu organizacion"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="K-Adaptacion_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:23px&quot;&gt;C&amp;#243;mo se adapta a tu organizaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Tres perillas que eligen &lt;b&gt;cu&amp;#225;nto&lt;/b&gt; m&amp;#233;todo, y cinco capas de reglas que eligen &lt;b&gt;c&amp;#243;mo&lt;/b&gt;.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1610" height="84" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n2" value="&lt;b style=&quot;font-size:14px&quot;&gt;1 &amp;#183; CAMINO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;&lt;i&gt;qu&amp;#233; etapas corren&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Once caminos, de &lt;b&gt;7 etapas&lt;/b&gt; (bugfix) a &lt;b&gt;33&lt;/b&gt; (feature y enterprise).&lt;br&gt;&lt;br&gt;Se elige al principio y &lt;b&gt;te dicen los n&amp;#250;meros exactos antes de empezar&lt;/b&gt;: cu&amp;#225;ntas etapas, cu&amp;#225;ntas compuertas.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="60" y="246" width="520" height="190" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n3" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Bullseye.svg;" vertex="1" parent="1"><mxGeometry x="72" y="258" width="24" height="24" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n4" value="&lt;b style=&quot;font-size:14px&quot;&gt;2 &amp;#183; PROFUNDIDAD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;&lt;i&gt;cu&amp;#225;nto detalle produce cada etapa&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;M&amp;#237;nima&lt;/b&gt; &amp;#8212; 1 o 2 p&amp;#225;ginas, solo decisiones clave, secciones opcionales fuera&lt;br&gt;&lt;b&gt;Est&amp;#225;ndar&lt;/b&gt; &amp;#8212; artefacto completo, todas las secciones, justificaci&amp;#243;n concisa&lt;br&gt;&lt;b&gt;Exhaustiva&lt;/b&gt; &amp;#8212; secciones opcionales dentro, justificaci&amp;#243;n detallada, referencias cruzadas de cumplimiento&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="595" y="246" width="520" height="190" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n5" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Layer_Group.svg;" vertex="1" parent="1"><mxGeometry x="607" y="258" width="24" height="24" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n6" value="&lt;b style=&quot;font-size:14px&quot;&gt;3 &amp;#183; ESTRATEGIA DE PRUEBA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;&lt;i&gt;cu&amp;#225;ntas pruebas se generan&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Los mismos tres niveles, pero &lt;b&gt;independientes de la profundidad&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Permite combinaciones como &lt;i&gt;artefactos completos con pruebas m&amp;#237;nimas&lt;/i&gt; &amp;#8212; &amp;#250;til en una prueba de concepto que igual hay que documentar.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#C9821F;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="1130" y="246" width="520" height="190" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n7" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Vials.svg;" vertex="1" parent="1"><mxGeometry x="1142" y="258" width="24" height="24" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n8" value="&lt;b style=&quot;font-size:14px&quot;&gt;LAS CINCO CAPAS DE REGLAS&lt;/b&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;estrictamente aditivas: &lt;b&gt;todo lo aplicable llega al contexto, nada se descarta en silencio&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#8A8A8A;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="458" width="1595" height="40" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n9" value="&lt;b style=&quot;font-size:12px&quot;&gt;org.md&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#666&quot;&gt;LO QUE TRAE AWS&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;116 l&amp;#237;neas con opini&amp;#243;n: trunk-based, squash-merge de Bolts, piso de 80% de cobertura en varios caminos, deploy-on-merge a staging con aprobaci&amp;#243;n manual a producci&amp;#243;n.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="60" y="516" width="300" height="200" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n10" value="&lt;b style=&quot;font-size:12px&quot;&gt;team.md&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#666&quot;&gt;LO QUE AFIRMA TU EQUIPO&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Llega &lt;b&gt;vac&amp;#237;o&lt;/b&gt;: solo encabezados con ejemplos comentados. Lo llena la etapa 2.2 en su compuerta de afirmaci&amp;#243;n, o el bucle de aprendizaje.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF3E0;strokeColor=#C9821F;" vertex="1" parent="1"><mxGeometry x="380" y="516" width="300" height="200" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n11" value="&lt;b style=&quot;font-size:12px&quot;&gt;project.md&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#666&quot;&gt;LO ESPEC&amp;#205;FICO DE ESTE PROYECTO&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Tambi&amp;#233;n vac&amp;#237;o. Para lo que solo aplica aqu&amp;#237;. Es el destino por defecto de un aprendizaje confirmado.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF3E0;strokeColor=#C9821F;" vertex="1" parent="1"><mxGeometry x="700" y="516" width="300" height="200" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n12" value="&lt;b style=&quot;font-size:12px&quot;&gt;phases/*.md&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#666&quot;&gt;POR FASE&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Una regla por fase. Ejemplo real: la de concepci&amp;#243;n exige que toda decisi&amp;#243;n de arquitectura documente &lt;b&gt;al menos dos alternativas&lt;/b&gt;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E3F2FD;strokeColor=#3D74AC;" vertex="1" parent="1"><mxGeometry x="1020" y="516" width="300" height="200" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n13" value="&lt;b style=&quot;font-size:12px&quot;&gt;por etapa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#666&quot;&gt;RESERVADO&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;La quinta capa est&amp;#225; declarada en el esquema pero &lt;b&gt;sin construir&lt;/b&gt;. No se puede autorar una regla que aplique solo a una etapa.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#AAAAAA;" vertex="1" parent="1"><mxGeometry x="1340" y="516" width="300" height="200" as="geometry" /></mxCell><mxCell id="K-Adaptacion_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="K-Adaptacion_n9" target="K-Adaptacion_n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="K-Adaptacion_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="K-Adaptacion_n10" target="K-Adaptacion_n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="K-Adaptacion_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="K-Adaptacion_n11" target="K-Adaptacion_n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="K-Adaptacion_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="K-Adaptacion_n12" target="K-Adaptacion_n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n18" value="&lt;b&gt;La regla que m&amp;#225;s pesa para una organizaci&amp;#243;n:&lt;/b&gt; una capa m&amp;#225;s estrecha &lt;b&gt;no puede contradecir&lt;/b&gt; a una m&amp;#225;s ancha. La compuerta de admisi&amp;#243;n compara cada aprendizaje contra la secci&amp;#243;n equivalente de &lt;code&gt;org.md&lt;/code&gt; y, si contradice, ofrece &lt;b&gt;revisar, saltar o escalar &amp;#8212; nunca forzar&lt;/b&gt;. No hay camino de override.&lt;br&gt;&lt;b&gt;Cada default de AWS que no encaje con tu organizaci&amp;#243;n es una decisi&amp;#243;n expl&amp;#237;cita, no algo que se pueda ignorar.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="60" y="746" width="1595" height="96" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n19" value="&lt;b style=&quot;font-size:14px&quot;&gt;LAS PLANTILLAS DE ARTEFACTO&lt;/b&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;la ranura construida, cableada a dos lectores&amp;#8230; y completamente vac&amp;#237;a&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#8A8A8A;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="1595" height="46" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n20" value="&lt;b&gt;C&amp;#243;mo funciona&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dejas un archivo con el nombre del artefacto en &lt;code&gt;memory/templates/&lt;/code&gt;, con los encabezados que quieres.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dos lectores usan el mismo archivo:&lt;/b&gt;&lt;br&gt;&amp;#160;&amp;#160;&amp;#183; el agente lo usa como &lt;b&gt;esqueleto a rellenar&lt;/b&gt;&lt;br&gt;&amp;#160;&amp;#160;&amp;#183; el sensor lo usa para &lt;b&gt;verificar la salida&lt;/b&gt;&lt;br&gt;&lt;br&gt;Por eso &lt;b&gt;la forma producida y la verificada no pueden divergir&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="780" height="240" as="geometry" /></mxCell><mxCell id="K-Adaptacion_n21" value="&lt;b&gt;Y aqu&amp;#237; est&amp;#225; el hueco&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;El framework no env&amp;#237;a ninguna plantilla.&lt;/b&gt; Ni una, en ninguno de los dos niveles.&lt;br&gt;&lt;br&gt;Sin plantilla, el sensor solo comprueba que el documento tenga &lt;b&gt;dos encabezados&lt;/b&gt;. Eso no es control de calidad documental.&lt;br&gt;&lt;br&gt;&lt;b&gt;Para entorno regulado esta es la palanca principal&lt;/b&gt;, y est&amp;#225; disponible: nadie la ha escrito, tampoco AWS. Y no requiere tocar el framework." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="875" y="930" width="780" height="240" as="geometry" /></mxCell><mxCell id="p11_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="128" width="1610" height="92" as="geometry" /></mxCell><mxCell id="p11_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="132" width="496" height="16" as="geometry" /></mxCell><mxCell id="p11_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p11_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p11_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p11_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p11_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p11_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p11_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="436" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p11_fr10" value="&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;&lt;b&gt;bolt&lt;/b&gt; = ciclo de horas o d&amp;#237;as, no de semanas &amp;#160;&amp;#183;&amp;#160; &lt;b&gt;unidad de trabajo&lt;/b&gt; = lo que antes era una &amp;#233;pica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="192" width="496" height="22" as="geometry" /></mxCell><mxCell id="p11_fr11" value="&lt;span style=&quot;font-size:9px;color:#888&quot;&gt;fontaner&amp;#237;a&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p11_fr12" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;INCEPTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="132" width="410" height="22" as="geometry" /></mxCell><mxCell id="p11_fr13" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;CONSTRUCTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p11_fr14" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;OPERATIONS&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p11_fr15" value="&lt;b style=&quot;font-size:11px&quot;&gt;0 &amp;#183; Inicializaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;3 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p11_fr16" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Ideaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p11_fr17" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Inception&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;9 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="988" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p11_fr18" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Construcci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p11_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p11_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="196" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>