PERATIONS&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p2_fr15" value="&lt;b style=&quot;font-size:11px&quot;&gt;0 &amp;#183; Inicializaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;3 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p2_fr16" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Ideaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p2_fr17" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Inception&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;9 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="988" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p2_fr18" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Construcci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p2_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p2_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="186" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="wf3" name="3 - Los once caminos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="F-Caminos_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;Los once caminos &amp;#8212; y por qu&amp;#233; el n&amp;#250;mero de etapas enga&amp;#241;a&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Contado del grafo compilado. &lt;b&gt;Un plan de 33 etapas no significa que corran 33.&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1560" height="74" as="geometry" /></mxCell><mxCell id="F-Caminos_n2" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;LOS ONCE CAMINOS&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="236" width="1540" height="696" as="geometry" /></mxCell><mxCell id="F-Caminos_n3" value="&lt;span style=&quot;font-size:11px;color:#666&quot;&gt;&lt;b&gt;camino&lt;/b&gt; &amp;#160;&amp;#160;&amp;#160; &lt;b&gt;etapas en el plan&lt;/b&gt; &amp;#160; &lt;b&gt;compuertas&lt;/b&gt; &amp;#160; &lt;b&gt;fijas&lt;/b&gt; &amp;#160; &lt;b&gt;condicionales&lt;/b&gt; &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;b&gt;para qu&amp;#233; es&lt;/b&gt; &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;b&gt;esqueleto&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=none;strokeColor=none;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="280" width="1492" height="30" as="geometry" /></mxCell><mxCell id="F-Caminos_n4" value="&lt;b style=&quot;font-size:12px&quot;&gt;enterprise      &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;33/33 &amp;#160;&amp;#160;&amp;#160; 30 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 8 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 22&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Trabajo regulado con rastro completo. Ning&amp;#250;n atajo.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: on&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="316" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n5" value="&lt;b style=&quot;font-size:12px&quot;&gt;feature         &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;33/33 &amp;#160;&amp;#160;&amp;#160; 30 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 8 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 22&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Funcionalidad nueva, ceremonia practicable. Mismo set que enterprise, menos profundidad.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: on&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="374" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n6" value="&lt;b style=&quot;font-size:12px&quot;&gt;classic         &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;26/33 &amp;#160;&amp;#160;&amp;#160; 23 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 5 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 18&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;b&gt;El default impl&amp;#237;cito.&lt;/b&gt; El ciclo estilo v1: sin ideaci&amp;#243;n, el resto se auto-selecciona.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: on&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="432" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n7" value="&lt;b style=&quot;font-size:12px&quot;&gt;workshop        &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;26/33 &amp;#160;&amp;#160;&amp;#160; 23 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 5 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 18&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Sesi&amp;#243;n facilitada. Mismo set que classic, con piso de pruebas ligero para ense&amp;#241;ar.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: on&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="490" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n8" value="&lt;b style=&quot;font-size:12px&quot;&gt;mvp             &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;23/33 &amp;#160;&amp;#160;&amp;#160; 20 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 7 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 13&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Recorta por delante y por detr&amp;#225;s: sin investigaci&amp;#243;n de mercado ni operaci&amp;#243;n.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: on&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="548" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n9" value="&lt;b style=&quot;font-size:12px&quot;&gt;infra           &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;13/33 &amp;#160;&amp;#160;&amp;#160; 10 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 1 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 9&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Se apoya en la mitad de atr&amp;#225;s: NFR, infraestructura, CI y todo el despliegue.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: on&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="606" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n10" value="&lt;b style=&quot;font-size:12px&quot;&gt;express         &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;10/33 &amp;#160;&amp;#160;&amp;#160; 7 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 3 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 4&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;La l&amp;#237;nea m&amp;#225;s recta: requisitos &amp;#8594; c&amp;#243;digo &amp;#8594; prueba &amp;#8594; desplegar. &lt;b&gt;Sin revisores.&lt;/b&gt;&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: off&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="664" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n11" value="&lt;b style=&quot;font-size:12px&quot;&gt;security-patch  &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;10/33 &amp;#160;&amp;#160;&amp;#160; 7 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 3 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 4&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Respuesta a un CVE. Estrecho pero &lt;b&gt;s&amp;#237; despliega&lt;/b&gt; &amp;#8212; para eso existe.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: off&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="722" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n12" value="&lt;b style=&quot;font-size:12px&quot;&gt;poc             &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;8/33 &amp;#160;&amp;#160;&amp;#160; 5 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 4 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 1&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&amp;#191;Esto puede funcionar? Captura la intenci&amp;#243;n, genera, prueba. Desechable.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: on&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="780" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n13" value="&lt;b style=&quot;font-size:12px&quot;&gt;refactor        &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;8/33 &amp;#160;&amp;#160;&amp;#160; 5 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 3 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 2&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Cambio que preserva el comportamiento. A&amp;#241;ade dise&amp;#241;o funcional sobre el camino de bugfix.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: off&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="838" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n14" value="&lt;b style=&quot;font-size:12px&quot;&gt;bugfix          &lt;/b&gt; &amp;#160;&amp;#160; &lt;span style=&quot;font-size:12px&quot;&gt;7/33 &amp;#160;&amp;#160;&amp;#160; 4 &amp;#160;&amp;#160;&amp;#160;&amp;#160; 3 &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 1&lt;/span&gt; &amp;#160;&amp;#160;&amp;#160; &lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Un bug concreto. Entender el c&amp;#243;digo, decir qu&amp;#233; es &amp;#171;arreglado&amp;#187;, cambiar y verificar.&lt;/span&gt; &amp;#160; &lt;span style=&quot;font-size:10px;color:#888&quot;&gt;skeleton: off&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="896" width="1492" height="48" as="geometry" /></mxCell><mxCell id="F-Caminos_n15" value="&lt;b&gt;Los dos ejes que deciden el recorrido&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Eje 1 &amp;#8212; el camino&lt;/b&gt; elige qu&amp;#233; etapas entran &lt;i&gt;en el plan&lt;/i&gt;. Se decide al principio, y te dicen los n&amp;#250;meros exactos antes de empezar.&lt;br&gt;&lt;br&gt;&lt;b&gt;Eje 2 &amp;#8212; la condici&amp;#243;n&lt;/b&gt; decide, ya en marcha, si una etapa del plan &lt;i&gt;de verdad corre&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Por eso un &lt;code&gt;feature&lt;/code&gt; con 33 etapas en el plan puede recorrer entre &lt;b&gt;11 y 33&lt;/b&gt;: solo 8 son fijas." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="976" width="760" height="250" as="geometry" /></mxCell><mxCell id="F-Caminos_n16" value="&lt;b&gt;C&amp;#243;mo se elige el camino&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#183; &lt;b&gt;Lo dices&lt;/b&gt;: &lt;code&gt;/aidlc bugfix&lt;/code&gt;&lt;br&gt;&amp;#183; &lt;b&gt;Lo infiere&lt;/b&gt; de palabras clave: &amp;#171;arreglar&amp;#187;, &amp;#171;refactorizar&amp;#187;, &amp;#171;CVE&amp;#187;, &amp;#171;prototipo&amp;#187;&amp;#8230;&lt;br&gt;&amp;#183; &lt;b&gt;Te propone uno a medida&lt;/b&gt; cuando describes algo largo &amp;#8212; puntuando cinco componentes de incertidumbre y justificando cada etapa que incluye &lt;i&gt;y cada una que descarta&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Regla de desambiguaci&amp;#243;n:&lt;/b&gt; si escribes una palabra clave &lt;i&gt;y&lt;/i&gt; m&amp;#225;s de cinco palabras de descripci&amp;#243;n, se ignora la palabra clave y se te ofrece el plan a medida. Evita que &amp;#171;arreglar el panel de monitoreo&amp;#187; se rutee a &lt;i&gt;bugfix&lt;/i&gt; por accidente." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="840" y="976" width="760" height="250" as="geometry" /></mxCell><mxCell id="p3_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="118" width="1560" height="92" as="geometry" /></mxCell><mxCell id="p3_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="122" width="496" height="16" as="geometry" /></mxCell><mxCell id="p3_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p3_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p3_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p3_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p3_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p3_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p3_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="436" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p3_fr10" value="&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;&lt;b&gt;bolt&lt;/b&gt; = ciclo de horas o d&amp;#237;as, no de semanas &amp;#160;&amp;#183;&amp;#160; &lt;b&gt;unidad de trabajo&lt;/b&gt; = lo que antes era una &amp;#233;pica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="182" width="496" height="22" as="geometry" /></mxCell><mxCell id="p3_fr11" value="&lt;span style=&quot;font-size:9px;color:#888&quot;&gt;fontaner&amp;#237;a&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p3_fr12" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;INCEPTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="122" width="410" height="22" as="geometry" /></mxCell><mxCell id="p3_fr13" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;CONSTRUCTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p3_fr14" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;OPERATIONS&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p3_fr15" value="&lt;b style=&quot;font-size:11px&quot;&gt;0 &amp;#183; Inicializaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;3 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p3_fr16" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Ideaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p3_fr17" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Inception&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;9 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="988" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p3_fr18" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Construcci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p3_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p3_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="186" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="wf4" name="4 - Que hace que una etapa corra"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="G-Condiciones_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;Qu&amp;#233; hace que una etapa del plan corra de verdad&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Las condiciones reales, le&amp;#237;das del &lt;i&gt;frontmatter&lt;/i&gt; de cada etapa. Esto es lo que produce recorridos distintos con el mismo camino.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="74" as="geometry" /></mxCell><mxCell id="G-Condiciones_n2" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;LAS CONDICIONES, TAL COMO EST&amp;#193;N ESCRITAS&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="236" width="1440" height="954" as="geometry" /></mxCell><mxCell id="G-Condiciones_n3" value="&lt;b style=&quot;font-size:12px&quot;&gt;1.2 Investigaci&amp;#243;n de mercado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hay posicionamiento externo o decisi&amp;#243;n de comprar-vs-construir. Se salta en herramientas internas.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="280" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n4" value="&lt;b style=&quot;font-size:12px&quot;&gt;1.3 Viabilidad&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hay restricciones de integraci&amp;#243;n, requisitos regulatorios o incertidumbre t&amp;#233;cnica seria.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="336" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n5" value="&lt;b style=&quot;font-size:12px&quot;&gt;1.5 Formaci&amp;#243;n del equipo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si la composici&amp;#243;n o la capacidad importan. Se salta con un solo desarrollador.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="392" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n6" value="&lt;b style=&quot;font-size:12px&quot;&gt;1.6 Bocetos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hay interfaz de usuario. Para APIs produce diagramas de interacci&amp;#243;n en su lugar.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="448" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n7" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;2.1 Ingenier&amp;#237;a inversa&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;b&gt;Corre si el proyecto es c&amp;#243;digo existente.&lt;/b&gt; Al repetir, comprueba si el escaneo previo sigue vigente y ofrece reutilizarlo.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="504" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n8" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;2.2 Pr&amp;#225;cticas del equipo&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;b&gt;Siempre se repite&lt;/b&gt; para mantenerla fresca. Sobre existente descubre de la evidencia; de cero, te pregunta.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="560" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n9" value="&lt;b style=&quot;font-size:12px&quot;&gt;2.4 Historias de usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hay funcionalidad de cara al usuario, varias personas, l&amp;#243;gica compleja o trabajo entre equipos.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="616" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n10" value="&lt;b style=&quot;font-size:12px&quot;&gt;2.5 Maquetas refinadas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hay UI &lt;i&gt;y&lt;/i&gt; hubo bocetos en ideaci&amp;#243;n.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="672" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n11" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;2.6 Dise&amp;#241;o de dominio&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;b&gt;Corre si hacen falta componentes nuevos. Se salta si solo modificas lo que ya existe.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="728" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n12" value="&lt;b style=&quot;font-size:12px&quot;&gt;2.8 Contratos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hay una frontera formal que fijar &amp;#8212; m&amp;#225;s de una Unit que se hablen entre s&amp;#237;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="784" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n13" value="&lt;b style=&quot;font-size:12px&quot;&gt;3.1 Dise&amp;#241;o funcional&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hay modelos de datos nuevos, l&amp;#243;gica compleja o reglas de negocio. Se salta en cambios simples.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="840" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n14" value="&lt;b style=&quot;font-size:12px&quot;&gt;3.2 Requisitos no funcionales&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hacen falta requisitos de rendimiento, seguridad, escala, fiabilidad u observabilidad.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="896" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n15" value="&lt;b style=&quot;font-size:12px&quot;&gt;3.3 Dise&amp;#241;o de los NFR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;b&gt;Corre solo si corri&amp;#243; el 3.2.&lt;/b&gt; Si aquel se salt&amp;#243;, este tambi&amp;#233;n.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="952" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n16" value="&lt;b style=&quot;font-size:12px&quot;&gt;3.4 Infraestructura&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hay que mapear servicios o hacen falta recursos en la nube.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="1008" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n17" value="&lt;b style=&quot;font-size:12px&quot;&gt;3.7 Pipeline de CI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Corre si hay que crearlo o modificarlo. &lt;b&gt;Se salta si el CI que hay ya sirve.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="1064" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n18" value="&lt;b style=&quot;font-size:12px&quot;&gt;4.1&amp;#8211;4.7 Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Cada una corre si su necesidad concreta existe: crear el CD, provisionar entornos, desplegar, montar observabilidad, escribir runbooks, validar carga, cerrar el bucle.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="84" y="1120" width="1392" height="46" as="geometry" /></mxCell><mxCell id="G-Condiciones_n19" value="&lt;b&gt;Las tres condiciones que m&amp;#225;s cambian el viaje&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;#191;Hay c&amp;#243;digo ya escrito?&lt;/b&gt; &amp;#8212; decide la ingenier&amp;#237;a inversa y voltea el comportamiento de las pr&amp;#225;cticas.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;#191;Componentes nuevos o modificaciones?&lt;/b&gt; &amp;#8212; decide si hay dise&amp;#241;o de dominio, y con &amp;#233;l media fase de concepci&amp;#243;n.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;#191;Hay interfaz de usuario?&lt;/b&gt; &amp;#8212; decide bocetos, maquetas e historias." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="1226" width="700" height="240" as="geometry" /></mxCell><mxCell id="G-Condiciones_n20" value="&lt;b&gt;Qui&amp;#233;n eval&amp;#250;a estas condiciones&lt;/b&gt;&lt;br&gt;&lt;br&gt;No es un &lt;code&gt;if&lt;/code&gt; en el c&amp;#243;digo: es &lt;b&gt;juicio de la IA sobre el contexto&lt;/b&gt;, y por eso pasa por compuerta como todo lo dem&amp;#225;s.&lt;br&gt;&lt;br&gt;Cuando una etapa se salta, queda registrado &lt;b&gt;con su raz&amp;#243;n&lt;/b&gt; en el expediente. Y en ideaci&amp;#243;n y concepci&amp;#243;n, la compuerta puede ofrecerte &lt;b&gt;volver a meter&lt;/b&gt; una etapa que se hab&amp;#237;a saltado.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Es la &amp;#250;nica circunstancia en que una compuerta ofrece una tercera opci&amp;#243;n.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="800" y="1226" width="700" height="240" as="geometry" /></mxCell><mxCell id="p4_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="118" width="1500" height="92" as="geometry" /></mxCell><mxCell id="p4_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="122" width="496" height="16" as="geometry" /></mxCell><mxCell id="p4_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p4_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p4_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p4_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p4_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p4_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p4_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="436" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p4_fr10" value="&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;&lt;b&gt;bolt&lt;/b&gt; = ciclo de horas o d&amp;#237;as, no de semanas &amp;#160;&amp;#183;&amp;#160; &lt;b&gt;unidad de trabajo&lt;/b&gt; = lo que antes era una &amp;#233;pica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="182" width="496" height="22" as="geometry" /></mxCell><mxCell id="p4_fr11" value="&lt;span style=&quot;font-size:9px;color:#888&quot;&gt;fontaner&amp;#237;a&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p4_fr12" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;INCEPTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="122" width="410" height="22" as="geometry" /></mxCell><mxCell id="p4_fr13" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;CONSTRUCTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p4_fr14" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;OPERATIONS&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p4_fr15" value="&lt;b style=&quot;font-size:11px&quot;&gt;0 &amp;#183; Inicializaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;3 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p4_fr16" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Ideaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p4_fr17" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Inception&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;9 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="988" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p4_fr18" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Construcci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p4_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p4_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="186" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="wf5" name="5 - El ciclo de una etapa"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="B-Etapa_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;El ciclo de &lt;i&gt;una&lt;/i&gt; etapa &amp;#8212; el patr&amp;#243;n que se repite 33 veces&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Le&amp;#237;do literalmente de los 33 archivos de etapa. Salvo excepciones contadas, &lt;b&gt;todas tienen esta misma forma&lt;/b&gt;.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="74" as="geometry" /></mxCell><mxCell id="B-Etapa_n2" value="&lt;b style=&quot;font-size:13px&quot;&gt;ENTRA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Los artefactos aprobados de las etapas anteriores.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="400" y="246" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n3" value="&lt;b style=&quot;font-size:13px&quot;&gt;1 &amp;#183; La IA se pone el rol que toca&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Arquitecto, product manager, QA, SRE&amp;#8230; seg&amp;#250;n la etapa. Con el conocimiento de ese oficio cargado.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="400" y="354" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n4" value="&lt;b style=&quot;font-size:13px&quot;&gt;2 &amp;#183; Lee lo que ya se decidi&amp;#243;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;No vuelve a preguntar lo que ya est&amp;#225; resuelto en una etapa previa.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="400" y="462" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n5" value="&lt;b style=&quot;font-size:13px&quot;&gt;3 &amp;#183; Eval&amp;#250;a qu&amp;#233; le falta saber&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Requisitos revisa seis dimensiones: funcional, no funcional, escenarios, negocio, t&amp;#233;cnico, calidad.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="400" y="570" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n6" value="&lt;b style=&quot;font-size:13px&quot;&gt;4 &amp;#183; PREGUNTA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Escribe las preguntas en un archivo y te deja elegir c&amp;#243;mo responder:&lt;br&gt;&lt;b&gt;Gu&amp;#237;ame&lt;/b&gt; &amp;#183; &lt;b&gt;Yo edito el archivo&lt;/b&gt; &amp;#183; &lt;b&gt;Conversemos&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;" vertex="1" parent="1"><mxGeometry x="400" y="678" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n7" value="&lt;b style=&quot;font-size:13px&quot;&gt;5 &amp;#183; Analiza tus respuestas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Busca vaguedad (&amp;#171;m&amp;#225;s o menos&amp;#187;, &amp;#171;depende&amp;#187;), contradicciones y evasivas.&lt;br&gt;&lt;b&gt;Si hay ambig&amp;#252;edad, vuelve a preguntar.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="400" y="786" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n8" value="&lt;b style=&quot;font-size:13px&quot;&gt;6 &amp;#183; Confirma el resumen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Te muestra todo lo decidido junto y espera un &lt;b&gt;&amp;#171;est&amp;#225; correcto&amp;#187;&lt;/b&gt; expl&amp;#237;cito.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;" vertex="1" parent="1"><mxGeometry x="400" y="894" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n9" value="&lt;b style=&quot;font-size:13px&quot;&gt;7 &amp;#183; PRODUCE los artefactos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Documentos, dise&amp;#241;os, c&amp;#243;digo. Con el detalle que corresponda a la profundidad elegida.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="400" y="1002" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n10" value="&lt;b style=&quot;font-size:13px&quot;&gt;8 &amp;#183; Un revisor independiente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Otro rol que &lt;b&gt;no vio c&amp;#243;mo se hizo&lt;/b&gt; intenta refutar el resultado. Veredicto: listo / no listo.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="400" y="1110" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n11" value="&lt;b style=&quot;font-size:13px&quot;&gt;9 &amp;#183; Recoge lo aprendido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Lo que se interpret&amp;#243;, en qu&amp;#233; se desvi&amp;#243;, qu&amp;#233; se descart&amp;#243;. T&amp;#250; eliges qu&amp;#233; conservar como regla.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;" vertex="1" parent="1"><mxGeometry x="400" y="1218" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n12" value="&lt;b style=&quot;font-size:13px&quot;&gt;10 &amp;#183; COMPUERTA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;&lt;b&gt;Aprobar&lt;/b&gt; o &lt;b&gt;pedir cambios&lt;/b&gt;. Nada avanza sin esto.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="400" y="1326" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_n13" value="&lt;b style=&quot;font-size:13px&quot;&gt;SALE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Los artefactos aprobados &amp;#8212; que son el contexto de la etapa siguiente.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="400" y="1434" width="620" height="88" as="geometry" /></mxCell><mxCell id="B-Etapa_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n2" target="B-Etapa_n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n3" target="B-Etapa_n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n4" target="B-Etapa_n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n5" target="B-Etapa_n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n6" target="B-Etapa_n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n7" target="B-Etapa_n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n8" target="B-Etapa_n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n9" target="B-Etapa_n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n10" target="B-Etapa_n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n11" target="B-Etapa_n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B-Etapa_n12" target="B-Etapa_n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e25" value="si algo qued&amp;#243; ambiguo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#B85450;" edge="1" parent="1" source="B-Etapa_n7" target="B-Etapa_n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_e26" value="si pides cambios" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#D6912B;" edge="1" parent="1" source="B-Etapa_n12" target="B-Etapa_n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="B-Etapa_n27" value="&lt;b&gt;Aqu&amp;#237; est&amp;#225;s t&amp;#250;&lt;/b&gt;&lt;br&gt;&lt;br&gt;La IA &lt;b&gt;nunca asume&lt;/b&gt;. Est&amp;#225; escrito como regla: &amp;#171;por defecto preguntar, no asumir; nunca proceder con ambig&amp;#252;edad&amp;#187;.&lt;br&gt;&lt;br&gt;Si respondes &lt;i&gt;&amp;#171;lo que t&amp;#250; creas&amp;#187;&lt;/i&gt;, te repregunta." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="70" y="678" width="300" height="200" as="geometry" /></mxCell><mxCell id="B-Etapa_n28" value="&lt;b&gt;La escotilla&lt;/b&gt;&lt;br&gt;&lt;br&gt;Si pides cambios &lt;b&gt;tres veces&lt;/b&gt; sobre la misma etapa, en la cuarta aparece &lt;b&gt;&amp;#171;acepta como est&amp;#225;&amp;#187;&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Y te avisan en la segunda de que va a aparecer.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Reconoce que el bucle de revisi&amp;#243;n puede volverse una trampa.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1060" y="1218" width="300" height="200" as="geometry" /></mxCell><mxCell id="B-Etapa_n29" value="&lt;b&gt;Las excepciones&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Historias de usuario&lt;/b&gt; se trabaja en &lt;i&gt;mob&lt;/i&gt;: cuatro roles a la vez.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ingenier&amp;#237;a inversa&lt;/b&gt; es una cadena: uno escanea, otro sintetiza.&lt;br&gt;&lt;br&gt;&lt;b&gt;Generaci&amp;#243;n de c&amp;#243;digo&lt;/b&gt; tiene una parada dura extra &amp;#8212; ver p&amp;#225;gina 3." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="70" y="1002" width="300" height="200" as="geometry" /></mxCell><mxCell id="p5_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="118" width="1200" height="92" as="geometry" /></mxCell><mxCell id="p5_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="122" width="496" height="16" as="geometry" /></mxCell><mxCell id="p5_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p5_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p5_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p5_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p5_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p5_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p5_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="436" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p5_fr10" value="&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;&lt;b&gt;bolt&lt;/b&gt; = ciclo de horas o d&amp;#237;as, no de semanas &amp;#160;&amp;#183;&amp;#160; &lt;b&gt;unidad de trabajo&lt;/b&gt; = lo que antes era una &amp;#233;pica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="182" width="496" height="22" as="geometry" /></mxCell><mxCell id="p5_fr11" value="&lt;span style=&quot;font-size:9px;color:#888&quot;&gt;fontaner&amp;#237;a&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p5_fr12" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;INCEPTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="122" width="410" height="22" as="geometry" /></mxCell><mxCell id="p5_fr13" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;CONSTRUCTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p5_fr14" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;OPERATIONS&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="122" width="200" height="22" as="geometry" /></mxCell><mxCell id="p5_fr15" value="&lt;b style=&quot;font-size:11px&quot;&gt;0 &amp;#183; Inicializaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;3 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p5_fr16" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Ideaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p5_fr17" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Inception&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;9 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="988" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p5_fr18" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Construcci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p5_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p5_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="186" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="wf6" name="6 - Construccion, Bolt por Bolt"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="C-Construccion_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;Construcci&amp;#243;n &amp;#8212; la &amp;#250;nica fase que no va etapa por etapa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Va &lt;b&gt;Bolt por Bolt&lt;/b&gt;. Un &lt;b&gt;Unit&lt;/b&gt; es una parte del sistema que se entrega sola; un &lt;b&gt;Bolt&lt;/b&gt; es el ciclo en que se construye.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="74" as="geometry" /></mxCell><mxCell id="C-Construccion_n2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Entra el plan de entrega&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;De la etapa 2.9: la secuencia de Bolts y qu&amp;#233; Units lleva cada uno.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="480" y="246" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n3" value="&lt;b style=&quot;font-size:13px&quot;&gt;BOLT 1 &amp;#8212; el esqueleto que camina&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;El primero va &lt;b&gt;solo y siempre con compuerta&lt;/b&gt;. Atraviesa el sistema de punta a punta con lo m&amp;#237;nimo, para probar que el camino funciona.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="480" y="352" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Se dise&amp;#241;a el Bolt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Para las Units de este Bolt: dise&amp;#241;o funcional, requisitos no funcionales, su dise&amp;#241;o, e infraestructura.&lt;br&gt;Las preguntas se juntan y se hacen &lt;b&gt;una sola vez&lt;/b&gt;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="480" y="458" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n5" value="&lt;b style=&quot;font-size:13px&quot;&gt;PARADA DURA &amp;#8212; aprobar el plan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Antes de escribir c&amp;#243;digo: se presenta el plan y las instrucciones de prueba, con una &lt;b&gt;huella criptogr&amp;#225;fica&lt;/b&gt;.&lt;br&gt;Cualquier cambio posterior la invalida y hay que volver a aprobar.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="480" y="564" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n6" value="&lt;b style=&quot;font-size:13px&quot;&gt;Se genera el c&amp;#243;digo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Una Unit a la vez, con sus pruebas. Nunca antes de la aprobaci&amp;#243;n anterior.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="480" y="670" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n7" value="&lt;b style=&quot;font-size:13px&quot;&gt;COMPUERTA del esqueleto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Revisas el primer Bolt completo antes de que corra ning&amp;#250;n otro.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="480" y="776" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n8" value="&lt;b style=&quot;font-size:13px&quot;&gt;&amp;#191;C&amp;#243;mo siguen los dem&amp;#225;s Bolts?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Se pregunta &lt;b&gt;una sola vez por proyecto&lt;/b&gt;: seguir de forma aut&amp;#243;noma, o revisar Bolt por Bolt.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;" vertex="1" parent="1"><mxGeometry x="480" y="882" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n9" value="&lt;b style=&quot;font-size:13px&quot;&gt;Los Bolts restantes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Los que no dependen entre s&amp;#237; corren &lt;b&gt;en paralelo&lt;/b&gt;. Si uno falla: se detiene, se conservan los que s&amp;#237; salieron, y te preguntan &amp;#8212; reintentar, saltar o abortar.&lt;br&gt;&lt;b&gt;Esto pasa aunque hayas elegido aut&amp;#243;nomo.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="480" y="988" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n10" value="&lt;b style=&quot;font-size:13px&quot;&gt;Construir y probar &amp;#8212; una vez al final&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Se corre la suite completa sobre todo lo construido.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="480" y="1094" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n11" value="&lt;b style=&quot;font-size:13px&quot;&gt;Pipeline de CI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Se deja configurado lo que va a construir y probar esto de aqu&amp;#237; en adelante.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="480" y="1200" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_n12" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sale c&amp;#243;digo probado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;M&amp;#225;s su infraestructura como c&amp;#243;digo y el pipeline que lo sostiene.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="480" y="1306" width="640" height="86" as="geometry" /></mxCell><mxCell id="C-Construccion_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n2" target="C-Construccion_n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n3" target="C-Construccion_n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n4" target="C-Construccion_n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n5" target="C-Construccion_n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n6" target="C-Construccion_n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n7" target="C-Construccion_n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n8" target="C-Construccion_n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n9" target="C-Construccion_n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n10" target="C-Construccion_n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="C-Construccion_n11" target="C-Construccion_n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_e23" value="por cada Bolt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#4A7EBB;" edge="1" parent="1" source="C-Construccion_n9" target="C-Construccion_n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="C-Construccion_n24" value="&lt;b&gt;Por qu&amp;#233; esta parada existe&lt;/b&gt;&lt;br&gt;&lt;br&gt;Es el punto donde la IA pasa de &lt;i&gt;proponer&lt;/i&gt; a &lt;i&gt;escribir c&amp;#243;digo&lt;/i&gt;.&lt;br&gt;&lt;br&gt;El texto de la etapa lo dice sin rodeos: &lt;i&gt;&amp;#171;no infieras la aprobaci&amp;#243;n de una continuaci&amp;#243;n del bucle&amp;#187;&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Solo un &amp;#171;apruebo el plan&amp;#187; expl&amp;#237;cito autoriza generar.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="100" y="564" width="340" height="200" as="geometry" /></mxCell><mxCell id="C-Construccion_n25" value="&lt;b&gt;La pregunta que m&amp;#225;s pesa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Se hace una vez, despu&amp;#233;s de ver el primer Bolt terminado &amp;#8212; cuando ya tienes evidencia de c&amp;#243;mo trabaja.&lt;br&gt;&lt;br&gt;No al principio, cuando a&amp;#250;n no sabes nada." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1160" y="882" width="340" height="190" as="geometry" /></mxCell><mxCell id="C-Construccion_n26" value="&lt;b&gt;Autonom&amp;#237;a con red&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aunque elijas aut&amp;#243;nomo, el sistema &lt;b&gt;no cree&lt;/b&gt; al agente cuando dice que termin&amp;#243;.&lt;br&gt;&lt;br&gt;Corre &lt;b&gt;el comando de prueba de tu proyecto&lt;/b&gt;. Si no da verde, no se integra.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Y compara el archivo de pruebas contra su versi&amp;#243;n original, para que nadie lo debilite y lo ponga verde.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1160" y="1094" width="340" height="210" as="geometry" /></mxCell><mxCell id="C-Construccion_n27" value="&lt;b&gt;Ojo&lt;/b&gt;&lt;br&gt;&lt;br&gt;El paralelismo &lt;b&gt;solo existe&lt;/b&gt; si la etapa 2.7 parti&amp;#243; el sistema en Units.&lt;br&gt;&lt;br&gt;En un &lt;i&gt;bugfix&lt;/i&gt;, un &lt;i&gt;refactor&lt;/i&gt; o una &lt;i&gt;prueba de concepto&lt;/i&gt; no hay Units: Construcci&amp;#243;n va de una sola pasada." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="100" y="1208" width="340" height="180" as="geometry" /></mxCell><mxCell id="p6_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="118" width="1500" height="92" as="geometry" /></mxCell><mxCell id="p6_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="122" width="496" height="16" as="geometry" /></mxCell><mxCell id="p6_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p6_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p6_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p6_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p6_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p6_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p6_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12