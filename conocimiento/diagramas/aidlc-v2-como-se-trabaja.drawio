okeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="532" width="932" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n12" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Code.svg;" vertex="1" parent="1"><mxGeometry x="94" y="548" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n13" value="&lt;b style=&quot;font-size:12px&quot;&gt;QA&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;judgment&lt;/span&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;3.6 &amp;#183; 4.6&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Construye y prueba; valida el rendimiento contra lo prometido&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="594" width="932" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n14" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Vials.svg;" vertex="1" parent="1"><mxGeometry x="94" y="610" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n15" value="&lt;b style=&quot;font-size:12px&quot;&gt;Plataforma AWS&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;judgment&lt;/span&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;3.4 &amp;#183; 4.2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Dise&amp;#241;a la infraestructura, provisiona los entornos&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="656" width="932" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n16" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Cloud.svg;" vertex="1" parent="1"><mxGeometry x="94" y="672" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n17" value="&lt;b style=&quot;font-size:12px&quot;&gt;Pipeline / Deploy&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;templated&lt;/span&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;2.2 &amp;#183; 3.7 &amp;#183; 4.1 &amp;#183; 4.3&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Descubre c&amp;#243;mo trabaja el equipo, integraci&amp;#243;n continua, despliegue&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="718" width="932" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n18" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Rocket.svg;" vertex="1" parent="1"><mxGeometry x="94" y="734" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n19" value="&lt;b style=&quot;font-size:12px&quot;&gt;SRE&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;templated&lt;/span&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;4.4 &amp;#183; 4.5 &amp;#183; 4.7&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Observabilidad, incidentes; cierra el bucle realimentando la ideaci&amp;#243;n&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="780" width="932" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n20" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Eye.svg;" vertex="1" parent="1"><mxGeometry x="94" y="796" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n21" value="&lt;b style=&quot;font-size:12px&quot;&gt;Cumplimiento&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;judgment&lt;/span&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;&lt;i&gt;solo apoya&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Nunca lidera una etapa. Aporta las restricciones regulatorias donde tocan&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="842" width="932" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n22" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Scale_Balanced.svg;" vertex="1" parent="1"><mxGeometry x="94" y="858" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n23" value="&lt;b style=&quot;font-size:12px&quot;&gt;DevSecOps&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;judgment&lt;/span&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;&lt;i&gt;solo apoya&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Nunca lidera. Modelado de amenazas y seguridad en el pipeline&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="904" width="932" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n24" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Shield.svg;" vertex="1" parent="1"><mxGeometry x="94" y="920" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n25" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;LOS TRES QUE NO PRODUCEN&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1080" y="240" width="570" height="250" as="geometry" /></mxCell><mxCell id="D-Roles_n26" value="&lt;b style=&quot;font-size:12px&quot;&gt;Revisor de producto&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;balanced&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Cuestiona requisitos, historias y maquetas. &lt;b&gt;No ve c&amp;#243;mo se hicieron.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1104" y="284" width="522" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n27" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Magnifying_Glass.svg;" vertex="1" parent="1"><mxGeometry x="1114" y="300" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n28" value="&lt;b style=&quot;font-size:12px&quot;&gt;Revisor de arquitectura&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;balanced&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Cuestiona los dise&amp;#241;os t&amp;#233;cnicos y el c&amp;#243;digo. Presupuesto duro: 60 turnos&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1104" y="346" width="522" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n29" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Gavel.svg;" vertex="1" parent="1"><mxGeometry x="1114" y="362" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n30" value="&lt;b style=&quot;font-size:12px&quot;&gt;Composer&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;judgment&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Arma un recorrido a medida cuando ninguno de los once caminos encaja&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1104" y="408" width="522" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n31" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Compass.svg;" vertex="1" parent="1"><mxGeometry x="1114" y="424" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n32" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;D&amp;#211;NDE DECIDE UNA PERSONA&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1080" y="520" width="570" height="440" as="geometry" /></mxCell><mxCell id="D-Roles_n33" value="&lt;b style=&quot;font-size:12px&quot;&gt;Al elegir el recorrido&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Te dicen cu&amp;#225;ntas etapas y compuertas, contadas, &lt;b&gt;antes&lt;/b&gt; de empezar&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#C9821F;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1104" y="564" width="522" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n34" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Bullseye.svg;" vertex="1" parent="1"><mxGeometry x="1114" y="580" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n35" value="&lt;b style=&quot;font-size:12px&quot;&gt;En cada pregunta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Eliges c&amp;#243;mo responder y confirmas el resumen antes de que se produzca nada&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#C9821F;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1104" y="626" width="522" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n36" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/List_Check.svg;" vertex="1" parent="1"><mxGeometry x="1114" y="642" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n37" value="&lt;b style=&quot;font-size:12px&quot;&gt;En cada compuerta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Aprobar o pedir cambios. &lt;b&gt;30 de las 33 etapas&lt;/b&gt; tienen compuerta&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#C9821F;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1104" y="688" width="522" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n38" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Circle_Check.svg;" vertex="1" parent="1"><mxGeometry x="1114" y="704" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n39" value="&lt;b style=&quot;font-size:12px&quot;&gt;Antes de generar c&amp;#243;digo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;La parada dura del plan, con huella criptogr&amp;#225;fica. Nunca se infiere&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#C9821F;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1104" y="750" width="522" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n40" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Gavel.svg;" vertex="1" parent="1"><mxGeometry x="1114" y="766" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n41" value="&lt;b style=&quot;font-size:12px&quot;&gt;Al decidir la autonom&amp;#237;a&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Una vez, tras ver el primer Bolt terminado&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#C9821F;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1104" y="812" width="522" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n42" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Gears.svg;" vertex="1" parent="1"><mxGeometry x="1114" y="828" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n43" value="&lt;b style=&quot;font-size:12px&quot;&gt;Al guardar un aprendizaje&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;T&amp;#250; eliges qu&amp;#233; se convierte en regla permanente&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#C9821F;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1104" y="874" width="522" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n44" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Database.svg;" vertex="1" parent="1"><mxGeometry x="1114" y="890" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n45" value="&lt;b&gt;Lo que la IA no decide nunca&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#183;&amp;#160;Marcar una etapa como terminada&lt;br&gt;&amp;#183;&amp;#160;Aprobar su propio trabajo en una compuerta&lt;br&gt;&amp;#183;&amp;#160;Empezar a generar c&amp;#243;digo sin el plan aprobado&lt;br&gt;&amp;#183;&amp;#160;Convertir una correcci&amp;#243;n tuya en regla sin que lo confirmes&lt;br&gt;&amp;#183;&amp;#160;Contradecir una regla de la organizaci&amp;#243;n&lt;br&gt;&amp;#183;&amp;#160;&lt;b&gt;Llamar a otro agente&lt;/b&gt; &amp;#8212; los catorce lo tienen prohibido en su definici&amp;#243;n" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="980" height="250" as="geometry" /></mxCell><mxCell id="D-Roles_n46" value="&lt;b&gt;Qu&amp;#233; significa cada nivel&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;judgment&lt;/b&gt; &amp;#8212; hereda tu modelo y tu esfuerzo. &lt;b&gt;Nunca se degrada por debajo de lo que elegiste.&lt;/b&gt; Ocho de los once.&lt;br&gt;&lt;br&gt;&lt;b&gt;balanced&lt;/b&gt; &amp;#8212; los dos revisores. Modelo medio, presupuesto de 60 turnos.&lt;br&gt;&lt;br&gt;&lt;b&gt;templated&lt;/b&gt; &amp;#8212; delivery, pipeline y SRE. Su salida es sobre todo planificaci&amp;#243;n, configuraci&amp;#243;n de CI/CD y esqueletos de runbook." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1080" y="990" width="570" height="250" as="geometry" /></mxCell><mxCell id="D-Roles_n47" value="&lt;b&gt;El reparto, en una frase:&lt;/b&gt; lo determinista lo hace una herramienta &amp;#160;&amp;#183;&amp;#160; lo que requiere conocimiento lo hace un rol de la IA &amp;#160;&amp;#183;&amp;#160; lo que requiere juicio lo hace una persona. &lt;b&gt;Cuando el m&amp;#233;todo duda de a cu&amp;#225;l pertenece algo, lo manda a la persona.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="1260" width="1590" height="60" as="geometry" /></mxCell><mxCell id="p7_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="128" width="1610" height="92" as="geometry" /></mxCell><mxCell id="p7_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="132" width="496" height="16" as="geometry" /></mxCell><mxCell id="p7_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p7_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p7_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p7_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p7_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p7_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="150" width="16" height="38" as="geometry" /></mxCell><mxCell id="p7_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="436" y="150" width="112" height="38" as="geometry" /></mxCell><mxCell id="p7_fr10" value="&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;&lt;b&gt;bolt&lt;/b&gt; = ciclo de horas o d&amp;#237;as, no de semanas &amp;#160;&amp;#183;&amp;#160; &lt;b&gt;unidad de trabajo&lt;/b&gt; = lo que antes era una &amp;#233;pica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="192" width="496" height="22" as="geometry" /></mxCell><mxCell id="p7_fr11" value="&lt;span style=&quot;font-size:9px;color:#888&quot;&gt;fontaner&amp;#237;a&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p7_fr12" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;INCEPTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="132" width="410" height="22" as="geometry" /></mxCell><mxCell id="p7_fr13" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;CONSTRUCTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p7_fr14" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;OPERATIONS&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="132" width="200" height="22" as="geometry" /></mxCell><mxCell id="p7_fr15" value="&lt;b style=&quot;font-size:11px&quot;&gt;0 &amp;#183; Inicializaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;3 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p7_fr16" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Ideaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p7_fr17" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Inception&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;9 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="988" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p7_fr18" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Construcci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p7_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="158" width="200" height="34" as="geometry" /></mxCell><mxCell id="p7_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="196" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="wf8" name="8 - Con que metodo trabaja cada rol"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="J-Biblioteca_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:23px&quot;&gt;Con qu&amp;#233; m&amp;#233;todo trabaja cada rol&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;59 gu&amp;#237;as, &lt;b&gt;6.559 l&amp;#237;neas&lt;/b&gt;. Cada rol carga las suyas antes de trabajar. &lt;b&gt;Esto es la metodolog&amp;#237;a propiamente dicha&lt;/b&gt; &amp;#8212; lo que el diagrama de etapas no muestra.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1610" height="84" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Product Manager&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#888&quot;&gt;7 gu&amp;#237;as&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;&lt;b&gt;Priorizaci&amp;#243;n:&lt;/b&gt; MoSCoW &amp;#183; WSJF &amp;#183; RICE &amp;#183; Kano&lt;br&gt;&lt;b&gt;Historias:&lt;/b&gt; INVEST &amp;#183; Given/When/Then &amp;#183; patrones de divisi&amp;#243;n &amp;#183; story mapping&lt;br&gt;&lt;b&gt;Elicitaci&amp;#243;n:&lt;/b&gt; entrevistas &amp;#183; talleres &amp;#183; indagaci&amp;#243;n contextual &amp;#183; an&amp;#225;lisis documental&lt;br&gt;&lt;b&gt;Mercado:&lt;/b&gt; SWOT &amp;#183; Cinco Fuerzas de Porter &amp;#183; TAM/SAM/SOM &amp;#183; comprar-vs-construir&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;spacingTop=30;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="246" width="380" height="282" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n3" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Lightbulb.svg;" vertex="1" parent="1"><mxGeometry x="72" y="256" width="22" height="22" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Arquitecto&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#888&quot;&gt;6 gu&amp;#237;as&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;&lt;b&gt;Dominio:&lt;/b&gt; DDD estrat&amp;#233;gico y t&amp;#225;ctico &amp;#183; Event Storming &amp;#183; hallazgos de dise&amp;#241;o&lt;br&gt;&lt;b&gt;Estilos:&lt;/b&gt; monolito modular &amp;#183; microservicios &amp;#183; serverless &amp;#183; dirigido por eventos &amp;#183; CQRS&lt;br&gt;&lt;b&gt;Resiliencia:&lt;/b&gt; circuit breaker &amp;#183; bulkhead &amp;#183; reintento exponencial &amp;#183; rate limiting&lt;br&gt;&lt;b&gt;Decisiones:&lt;/b&gt; plantilla de ADR con contexto, decisi&amp;#243;n, consecuencias y alternativas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;spacingTop=30;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="465" y="246" width="380" height="282" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n5" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Sitemap.svg;" vertex="1" parent="1"><mxGeometry x="477" y="256" width="22" height="22" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n6" value="&lt;b style=&quot;font-size:13px&quot;&gt;Dise&amp;#241;ador UX&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#888&quot;&gt;5 gu&amp;#237;as&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;&lt;b&gt;Usabilidad:&lt;/b&gt; las 10 heur&amp;#237;sticas de Nielsen&lt;br&gt;&lt;b&gt;Accesibilidad:&lt;/b&gt; WCAG 2.1 AA &amp;#183; los cuatro principios POUR &amp;#183; ARIA&lt;br&gt;&lt;b&gt;Interacci&amp;#243;n:&lt;/b&gt; navegaci&amp;#243;n &amp;#183; formularios &amp;#183; modales &amp;#183; revelaci&amp;#243;n progresiva&lt;br&gt;&lt;b&gt;Bocetos:&lt;/b&gt; progresi&amp;#243;n de fidelidad &amp;#183; estados de pantalla&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;spacingTop=30;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="870" y="246" width="380" height="282" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n7" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Palette.svg;" vertex="1" parent="1"><mxGeometry x="882" y="256" width="22" height="22" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n8" value="&lt;b style=&quot;font-size:13px&quot;&gt;Desarrollador&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#888&quot;&gt;6 gu&amp;#237;as&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;&lt;b&gt;API:&lt;/b&gt; convenciones de URL &amp;#183; sem&amp;#225;ntica HTTP &amp;#183; c&amp;#243;digos de estado &amp;#183; paginaci&amp;#243;n &amp;#183; versionado&lt;br&gt;&lt;b&gt;Lectura de c&amp;#243;digo:&lt;/b&gt; descubrimiento de build &amp;#183; detecci&amp;#243;n de framework &amp;#183; grafo de dependencias&lt;br&gt;&lt;b&gt;Generaci&amp;#243;n:&lt;/b&gt; selecci&amp;#243;n de patr&amp;#243;n &amp;#183; &lt;b&gt;buenas pr&amp;#225;cticas para modificar lo existente&lt;/b&gt;&lt;br&gt;&lt;b&gt;Datos:&lt;/b&gt; patrones de modelado&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;spacingTop=30;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1275" y="246" width="380" height="282" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n9" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Code.svg;" vertex="1" parent="1"><mxGeometry x="1287" y="256" width="22" height="22" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n10" value="&lt;b style=&quot;font-size:13px&quot;&gt;QA&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#888&quot;&gt;4 gu&amp;#237;as&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;&lt;b&gt;Estrategia:&lt;/b&gt; pir&amp;#225;mide de pruebas &amp;#183; dobles de prueba &amp;#183; gesti&amp;#243;n de datos de prueba&lt;br&gt;&lt;b&gt;Avanzado:&lt;/b&gt; pruebas de contrato &amp;#183; basadas en propiedades &amp;#183; de mutaci&amp;#243;n&lt;br&gt;&lt;b&gt;Rendimiento:&lt;/b&gt; percentiles de latencia &amp;#183; medici&amp;#243;n de throughput &amp;#183; planificaci&amp;#243;n de capacidad&lt;br&gt;&lt;b&gt;Cierre:&lt;/b&gt; matriz objetivo-vs-real de los requisitos no funcionales&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;spacingTop=30;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="548" width="380" height="282" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n11" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Vials.svg;" vertex="1" parent="1"><mxGeometry x="72" y="558" width="22" height="22" as="geometry" /></mxCell><mxCell id="J-Biblioteca_n12" value="&lt;b style=&quot;font-size:13px&quot;&gt;DevSecOps&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:10px;color:#888&quot;&gt;4 gu&amp;#237;as&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;&lt;b&gt;Amenazas:&lt;/b&gt; STRIDE &amp;#183; DREAD &amp;#183; an&amp;#225;lisis de superficie de ataque &amp;#183; mapeo de mitigaciones&lt;br&gt;&lt;b&gt;Aplicaci&amp;#243;n:&lt;/b&gt; OWASP Top 10 &amp;#183; patrones de autenticaci&amp;#243;n y autorizaci&amp;#243;n&lt;br&gt;&lt;b&gt;Pipeline:&lt;/b&gt; SAST &amp;#183; DAST &amp;#183; escaneo de dependencias, de IaC, de secretos y de im&amp;#225;genes&lt;br&gt;&lt;b&gt;Requisitos:&lt;/b&gt; plantillas de requisito de seguridad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left