le="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p6_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="148" width="200" height="34" as="geometry" /></mxCell><mxCell id="p6_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="186" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="wf7" name="7 - Los catorce oficios"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="D-Roles_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:23px&quot;&gt;Los catorce oficios &amp;#8212; y d&amp;#243;nde decide una persona&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;La IA adopta el rol que la etapa pide. &lt;b&gt;Ninguno puede llamar a otro&lt;/b&gt;: solo el orquestador reparte trabajo.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1610" height="84" as="geometry" /></mxCell><mxCell id="D-Roles_n2" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;LOS ONCE QUE PRODUCEN&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="980" height="738" as="geometry" /></mxCell><mxCell id="D-Roles_n3" value="&lt;b style=&quot;font-size:12px&quot;&gt;Product Manager&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;judgment&lt;/span&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;1.1 &amp;#183; 1.2 &amp;#183; 1.4 &amp;#183; 2.3 &amp;#183; 2.4&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Captura la intenci&amp;#243;n, investiga el mercado, define el alcance, escribe requisitos e historias&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="284" width="932" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n4" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Lightbulb.svg;" vertex="1" parent="1"><mxGeometry x="94" y="300" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n5" value="&lt;b style=&quot;font-size:12px&quot;&gt;Arquitecto&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;judgment&lt;/span&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;1.3 &amp;#183; 2.6 &amp;#183; 2.7 &amp;#183; 2.8 &amp;#183; 3.1 &amp;#183; 3.2 &amp;#183; 3.3&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;b&gt;El de mayor alcance: 7 etapas en 3 fases.&lt;/b&gt; Viabilidad, dominio, unidades, contratos, requisitos y dise&amp;#241;o no funcionales&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="346" width="932" height="52" as="geometry" /></mxCell><mxCell id="D-Roles_n6" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Sitemap.svg;" vertex="1" parent="1"><mxGeometry x="94" y="362" width="22" height="22" as="geometry" /></mxCell><mxCell id="D-Roles_n7" value="&lt;b style=&quot;font-size:12px&quot;&gt;Delivery Manager&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:9px;color:#AAA&quot;&gt;templated&lt;/span&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;1.5 &amp;#183; 1.7 &amp;#183; 2.9&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Forma el equipo, aprueba y traspasa, planifica la entrega en Bolts&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#3D74AC;verticalAlign=middle;spacing=4;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="84" y="408" width="932" height="52" as="geometry" /></mxCell><