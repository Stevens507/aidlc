Color=#B0175A;dashed=1;dashPattern=6 4;verticalAlign=middle;spacing=4;spacingLeft=34;" vertex="1" parent="1"><mxGeometry x="1378" y="492" width="274" height="56" as="geometry" /></mxCell><mxCell id="V-Ciclo_n78" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Box_Open.svg;" vertex="1" parent="1"><mxGeometry x="1387" y="509" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n79" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Building.svg;" vertex="1" parent="1"><mxGeometry x="1622" y="510" width="20" height="20" as="geometry" /></mxCell><mxCell id="V-Ciclo_n80" value="&lt;b style=&quot;font-size:11px&quot;&gt;4.4&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:11px&quot;&gt;Observabilidad&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777&quot;&gt;SRE&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#B0175A;dashed=1;dashPattern=6 4;verticalAlign=middle;spacing=4;spacingLeft=34;" vertex="1" parent="1"><mxGeometry x="1378" y="558" width="274" height="56" as="geometry" /></mxCell><mxCell id="V-Ciclo_n81" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Eye.svg;" vertex="1" parent="1"><mxGeometry x="1387" y="575" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n82" value="&lt;b style=&quot;font-size:11px&quot;&gt;4.5&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:11px&quot;&gt;Respuesta a incidentes&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777&quot;&gt;SRE&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#B0175A;dashed=1;dashPattern=6 4;verticalAlign=middle;spacing=4;spacingLeft=34;" vertex="1" parent="1"><mxGeometry x="1378" y="624" width="274" height="56" as="geometry" /></mxCell><mxCell id="V-Ciclo_n83" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Fire_Extinguisher.svg;" vertex="1" parent="1"><mxGeometry x="1387" y="641" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n84" value="&lt;b style=&quot;font-size:11px&quot;&gt;4.6&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:11px&quot;&gt;Validación de rendimiento&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777&quot;&gt;QA&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#B0175A;dashed=1;dashPattern=6 4;verticalAlign=middle;spacing=4;spacingLeft=34;" vertex="1" parent="1"><mxGeometry x="1378" y="690" width="274" height="56" as="geometry" /></mxCell><mxCell id="V-Ciclo_n85" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Bolt_Lightning.svg;" vertex="1" parent="1"><mxGeometry x="1387" y="707" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n86" value="&lt;b style=&quot;font-size:11px&quot;&gt;4.7&lt;/b&gt; &amp;#160;&lt;span style=&quot;font-size:11px&quot;&gt;Retroalimentación&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777&quot;&gt;SRE&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FCE4EC;strokeColor=#B0175A;dashed=1;dashPattern=6 4;verticalAlign=middle;spacing=4;spacingLeft=34;" vertex="1" parent="1"><mxGeometry x="1378" y="756" width="274" height="56" as="geometry" /></mxCell><mxCell id="V-Ciclo_n87" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Recycle.svg;" vertex="1" parent="1"><mxGeometry x="1387" y="773" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n88" value="&lt;b style=&quot;font-size:11px&quot;&gt;SALE DE AQU&amp;#205;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Desplegado, con tableros, alarmas, objetivos de servicio y runbooks. El 4.7 &lt;b&gt;realimenta&lt;/b&gt; la ideación.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="1360" y="970" width="310" height="148" as="geometry" /></mxCell><mxCell id="V-Ciclo_e89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="V-Ciclo_n2" target="V-Ciclo_n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="V-Ciclo_e90" value="verificaci&amp;#243;n de trazabilidad" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="V-Ciclo_n11" target="V-Ciclo_n28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="V-Ciclo_e91" value="verificaci&amp;#243;n de trazabilidad" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="V-Ciclo_n28" target="V-Ciclo_n52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="V-Ciclo_e92" value="verificaci&amp;#243;n de trazabilidad" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="V-Ciclo_n52" target="V-Ciclo_n71"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="V-Ciclo_n93" value="&lt;b style=&quot;font-size:14px&quot;&gt;CUANDO YA HAY C&amp;#211;DIGO CORRIENDO&lt;/b&gt; &amp;#160;&amp;#160;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;seis salvaguardas que &lt;b&gt;no existen en un proyecto nuevo&lt;/b&gt;. El riesgo deja de ser &lt;i&gt;construir lo que no era&lt;/i&gt; y pasa a ser &lt;i&gt;romper lo que s&amp;#237; era&lt;/i&gt;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E3F2FD;strokeColor=#3D74AC;strokeWidth=2;verticalAlign=middle;spacingLeft=48;" vertex="1" parent="1"><mxGeometry x="60" y="1146" width="1610" height="46" as="geometry" /></mxCell><mxCell id="V-Ciclo_n94" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Building.svg;" vertex="1" parent="1"><mxGeometry x="78" y="1156" width="26" height="26" as="geometry" /></mxCell><mxCell id="V-Ciclo_n95" value="&lt;b style=&quot;font-size:11px&quot;&gt;Radio de impacto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#3D74AC&quot;&gt;&lt;b&gt;2.1 &amp;#183; 3.5&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Qu&amp;#233; archivos se tocan y &lt;b&gt;qui&amp;#233;n depende de ellos&lt;/b&gt;. Impacto bajo / medio / alto, presentado antes de proceder&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F4F9FE;strokeColor=#3D74AC;spacingTop=32;" vertex="1" parent="1"><mxGeometry x="60" y="1204" width="254" height="118" as="geometry" /></mxCell><mxCell id="V-Ciclo_n96" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Magnifying_Glass.svg;" vertex="1" parent="1"><mxGeometry x="70" y="1210" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n97" value="&lt;b style=&quot;font-size:11px&quot;&gt;Vista previa del cambio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#3D74AC&quot;&gt;&lt;b&gt;cualquiera&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;El cambio exacto &lt;b&gt;antes&lt;/b&gt; de aplicarlo. Nunca a ciegas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F4F9FE;strokeColor=#3D74AC;spacingTop=32;" vertex="1" parent="1"><mxGeometry x="330" y="1204" width="254" height="118" as="geometry" /></mxCell><mxCell id="V-Ciclo_n98" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Code_Compare.svg;" vertex="1" parent="1"><mxGeometry x="340" y="1210" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n99" value="&lt;b style=&quot;font-size:11px&quot;&gt;An&amp;#225;lisis de impacto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#3D74AC&quot;&gt;&lt;b&gt;2.1 &amp;#183; 3.5&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;Qu&amp;#233; APIs, componentes y dependencias quedan afectados&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F4F9FE;strokeColor=#3D74AC;spacingTop=32;" vertex="1" parent="1"><mxGeometry x="600" y="1204" width="254" height="118" as="geometry" /></mxCell><mxCell id="V-Ciclo_n100" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Sitemap.svg;" vertex="1" parent="1"><mxGeometry x="610" y="1210" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n101" value="&lt;b style=&quot;font-size:11px&quot;&gt;L&amp;#237;nea base de pruebas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#3D74AC&quot;&gt;&lt;b&gt;antes de 3.5&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;La suite &lt;b&gt;antes de tocar nada&lt;/b&gt;: total, pasan, fallan, cobertura&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F4F9FE;strokeColor=#3D74AC;spacingTop=32;" vertex="1" parent="1"><mxGeometry x="870" y="1204" width="254" height="118" as="geometry" /></mxCell><mxCell id="V-Ciclo_n102" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Vials.svg;" vertex="1" parent="1"><mxGeometry x="880" y="1210" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n103" value="&lt;b style=&quot;font-size:11px&quot;&gt;Validaci&amp;#243;n de pruebas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#3D74AC&quot;&gt;&lt;b&gt;3.6&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;La suite despu&amp;#233;s. &lt;b&gt;Los fallos nuevos son regresiones del cambio&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F4F9FE;strokeColor=#3D74AC;spacingTop=32;" vertex="1" parent="1"><mxGeometry x="1140" y="1204" width="254" height="118" as="geometry" /></mxCell><mxCell id="V-Ciclo_n104" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Circle_Check.svg;" vertex="1" parent="1"><mxGeometry x="1150" y="1210" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n105" value="&lt;b style=&quot;font-size:11px&quot;&gt;Plan de reversi&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#3D74AC&quot;&gt;&lt;b&gt;antes de 4.3&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#333&quot;&gt;C&amp;#243;mo deshacerlo. &lt;b&gt;Antes de desplegar&lt;/b&gt;, no tras el incidente&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F4F9FE;strokeColor=#3D74AC;spacingTop=32;" vertex="1" parent="1"><mxGeometry x="1410" y="1204" width="254" height="118" as="geometry" /></mxCell><mxCell id="V-Ciclo_n106" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Arrows_Split_Up_And_Left.svg;" vertex="1" parent="1"><mxGeometry x="1420" y="1210" width="22" height="22" as="geometry" /></mxCell><mxCell id="V-Ciclo_n107" value="&lt;b&gt;Lo que el dibujo hace visible de un vistazo&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#183;&amp;#160;&lt;b&gt;Cuenta los bordes s&amp;#243;lidos: son solo 11 de 33.&lt;/b&gt; El resto se auto-selecciona seg&amp;#250;n el proyecto. Por eso un plan de 33 etapas puede recorrer entre 11 y 33 &amp;#8212; ver &lt;i&gt;Los once caminos&lt;/i&gt;.&lt;br&gt;&amp;#183;&amp;#160;&lt;b&gt;La ideaci&amp;#243;n es la m&amp;#225;s prescindible&lt;/b&gt; (6 de sus 7 son condicionales) y la &lt;b&gt;concepci&amp;#243;n la m&amp;#225;s densa&lt;/b&gt;. Ah&amp;#237; se decide qu&amp;#233; se construye.&lt;br&gt;&amp;#183;&amp;#160;&lt;b&gt;Entre fase y fase se verifica la trazabilidad antes de avanzar:&lt;/b&gt; intenci&amp;#243;n &amp;#8594; alcance &amp;#8594; requisitos &amp;#8594; dise&amp;#241;os &amp;#8594; unidades &amp;#8594; c&amp;#243;digo &amp;#8594; pruebas &amp;#8594; despliegue. Si falta un eslab&amp;#243;n, se presenta el problema y &lt;b&gt;no se avanza&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="1346" width="1610" height="122" as="geometry" /></mxCell><mxCell id="p1_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1610" height="92" as="geometry" /></mxCell><mxCell id="p1_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="144" width="496" height="16" as="geometry" /></mxCell><mxCell id="p1_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="162" width="112" height="38" as="geometry" /></mxCell><mxCell id="p1_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="162" width="16" height="38" as="geometry" /></mxCell><mxCell id="p1_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="162" width="112" height="38" as="geometry" /></mxCell><mxCell id="p1_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="162" width="16" height="38" as="geometry" /></mxCell><mxCell id="p1_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="162" width="112" height="38" as="geometry" /></mxCell><mxCell id="p1_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="162" width="16" height="38" as="geometry" /></mxCell><mxCell id="p1_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="436" y="162" width="112" height="38" as="geometry" /></mxCell><mxCell id="p1_fr10" value="&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;&lt;b&gt;bolt&lt;/b&gt; = ciclo de horas o d&amp;#237;as, no de semanas &amp;#160;&amp;#183;&amp;#160; &lt;b&gt;unidad de trabajo&lt;/b&gt; = lo que antes era una &amp;#233;pica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="204" width="496" height="22" as="geometry" /></mxCell><mxCell id="p1_fr11" value="&lt;span style=&quot;font-size:9px;color:#888&quot;&gt;fontaner&amp;#237;a&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="144" width="200" height="22" as="geometry" /></mxCell><mxCell id="p1_fr12" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;INCEPTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="144" width="410" height="22" as="geometry" /></mxCell><mxCell id="p1_fr13" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;CONSTRUCTION&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="144" width="200" height="22" as="geometry" /></mxCell><mxCell id="p1_fr14" value="&lt;span style=&quot;font-size:11px;color:#333&quot;&gt;&lt;b&gt;OPERATIONS&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#EDEDED;strokeColor=#666666;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="144" width="200" height="22" as="geometry" /></mxCell><mxCell id="p1_fr15" value="&lt;b style=&quot;font-size:11px&quot;&gt;0 &amp;#183; Inicializaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;3 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#F0F0F0;strokeColor=#8A8A8A;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="170" width="200" height="34" as="geometry" /></mxCell><mxCell id="p1_fr16" value="&lt;b style=&quot;font-size:11px&quot;&gt;1 &amp;#183; Ideaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="778" y="170" width="200" height="34" as="geometry" /></mxCell><mxCell id="p1_fr17" value="&lt;b style=&quot;font-size:11px&quot;&gt;2 &amp;#183; Inception&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;9 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="988" y="170" width="200" height="34" as="geometry" /></mxCell><mxCell id="p1_fr18" value="&lt;b style=&quot;font-size:11px&quot;&gt;3 &amp;#183; Construcci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1198" y="170" width="200" height="34" as="geometry" /></mxCell><mxCell id="p1_fr19" value="&lt;b style=&quot;font-size:11px&quot;&gt;4 &amp;#183; Operaci&amp;#243;n&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#555&quot;&gt;7 etapas&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="1408" y="170" width="200" height="34" as="geometry" /></mxCell><mxCell id="p1_fr20" value="&lt;span style=&quot;font-size:9px;color:#B85450&quot;&gt;&lt;b&gt;El paper describe 3 fases; v2 implementa 5.&lt;/b&gt; &amp;#171;Inception&amp;#187; en el paper abarca &lt;b&gt;ideaci&amp;#243;n + inception&lt;/b&gt; de v2 &amp;#8212; la pantalla que dice INCEPTION no est&amp;#225; donde el paper dice.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FBE3E2;strokeColor=#B85450;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="568" y="208" width="1040" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="wf2" name="2 - De cero, o sobre algo que ya existe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2442" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="E-Bifurcacion_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;La bifurcaci&amp;#243;n &amp;#8212; empezar de cero, o cambiar algo que ya existe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Es la decisi&amp;#243;n que m&amp;#225;s cambia el recorrido, y &lt;b&gt;no la tomas t&amp;#250;&lt;/b&gt;: la decide un escaneo determinista del directorio.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1560" height="74" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Antes de nada: se escanea el directorio&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Es c&amp;#243;digo existente&lt;/b&gt; si aparece &lt;i&gt;cualquiera&lt;/i&gt; de: archivos fuente en 15 lenguajes reconocidos &amp;#183; configuraci&amp;#243;n de framework &amp;#183; manifiesto con dependencias de aplicaci&amp;#243;n &amp;#183; carpetas &lt;code&gt;src/ app/ lib/ pages/&lt;/code&gt; &amp;#183; un &lt;code&gt;.gitmodules&lt;/code&gt; con subm&amp;#243;dulos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Es de cero&lt;/b&gt; solo si &lt;i&gt;ninguna&lt;/i&gt; de esas aparece. Un README, un LICENSE, un &lt;code&gt;.gitignore&lt;/code&gt; o CI sin c&amp;#243;digo &lt;b&gt;no&lt;/b&gt; cuentan." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="430" y="236" width="780" height="158" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n3" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;EMPEZAR DE CERO &amp;#8212; &lt;i&gt;greenfield&lt;/i&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="426" width="740" height="790" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n4" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;CAMBIAR ALGO QUE YA EXISTE &amp;#8212; &lt;i&gt;brownfield&lt;/i&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="426" width="740" height="790" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ideaci&amp;#243;n completa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;No hay nada construido, as&amp;#237; que &lt;b&gt;aqu&amp;#237; es donde m&amp;#225;s aporta&lt;/b&gt;: qu&amp;#233; construir, para qui&amp;#233;n, qu&amp;#233; queda fuera.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="84" y="482" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n6" value="&lt;b style=&quot;font-size:13px&quot;&gt;2.1 Ingenier&amp;#237;a inversa &amp;#8212; SE SALTA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;No hay c&amp;#243;digo que leer.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#BBBBBB;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="84" y="572" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n7" value="&lt;b style=&quot;font-size:13px&quot;&gt;2.2 Pr&amp;#225;cticas &amp;#8212; &lt;b&gt;te pregunta&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;No hay evidencia que mirar, as&amp;#237; que te interroga usando los valores por defecto de la organizaci&amp;#243;n.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;" vertex="1" parent="1"><mxGeometry x="84" y="662" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n8" value="&lt;b style=&quot;font-size:13px&quot;&gt;Requisitos e historias&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Se escriben desde la intenci&amp;#243;n, sin nada previo que respetar.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="84" y="752" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n9" value="&lt;b style=&quot;font-size:13px&quot;&gt;2.6 Dise&amp;#241;o de dominio &amp;#8212; &lt;b&gt;corre&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Todos los componentes son nuevos: hay que modelarlos.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="84" y="842" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n10" value="&lt;b style=&quot;font-size:13px&quot;&gt;2.7 Se parte en Units&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;El sistema se divide en piezas entregables por separado. &lt;b&gt;Esto habilita el paralelismo.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="84" y="932" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n11" value="&lt;b style=&quot;font-size:13px&quot;&gt;El esqueleto que camina &amp;#8212; PRIMERO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;&lt;code&gt;skeleton: on&lt;/code&gt;. El primer Bolt atraviesa el sistema de punta a punta con lo m&amp;#237;nimo, para probar que el camino existe.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="1022" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n12" value="&lt;b style=&quot;font-size:13px&quot;&gt;Operaci&amp;#243;n completa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;No hay nada desplegado: hay que montar pipeline, entornos, observabilidad y runbooks.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="84" y="1112" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n13" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ideaci&amp;#243;n &amp;#8212; normalmente SE SALTA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;No hay producto nuevo que descubrir. Los tres scopes incrementales la omiten entera.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#BBBBBB;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="884" y="482" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n14" value="&lt;b style=&quot;font-size:13px&quot;&gt;2.1 Ingenier&amp;#237;a inversa &amp;#8212; &lt;b&gt;LO PRIMERO&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;La etapa clave de este camino. Produce &lt;b&gt;9 artefactos&lt;/b&gt;: visi&amp;#243;n de negocio, arquitectura, estructura del c&amp;#243;digo, API, inventario de componentes, stack, dependencias y evaluaci&amp;#243;n de calidad.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="884" y="572" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n15" value="&lt;b style=&quot;font-size:13px&quot;&gt;2.2 Pr&amp;#225;cticas &amp;#8212; &lt;b&gt;las descubre&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;No te pregunta: las deduce de la evidencia del repositorio y de lo que acaba de leer.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="884" y="662" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n16" value="&lt;b style=&quot;font-size:13px&quot;&gt;Requisitos &amp;#8212; acotados al cambio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Qu&amp;#233; significa &amp;#171;arreglado&amp;#187; o &amp;#171;cambiado&amp;#187;. No se re-especifica el sistema entero.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="884" y="752" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n17" value="&lt;b style=&quot;font-size:13px&quot;&gt;2.6 Dise&amp;#241;o de dominio &amp;#8212; &lt;b&gt;se salta&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Su condici&amp;#243;n lo dice: se omite cuando los cambios son modificaciones a componentes que ya existen.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#EFEFEF;strokeColor=#BBBBBB;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="884" y="842" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n18" value="&lt;b style=&quot;font-size:13px&quot;&gt;Units &amp;#8212; solo en scopes grandes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Un &lt;i&gt;bugfix&lt;/i&gt; o un &lt;i&gt;refactor&lt;/i&gt; no parten nada. &lt;b&gt;Sin Units no hay paralelismo&lt;/b&gt;: Construcci&amp;#243;n va de una pasada.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="884" y="932" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n19" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sin esqueleto que camina&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;&lt;code&gt;skeleton: off&lt;/code&gt; en bugfix, refactor y security-patch. No hay nada que arrancar &amp;#8212; el sistema ya camina.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="884" y="1022" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n20" value="&lt;b style=&quot;font-size:13px&quot;&gt;Operaci&amp;#243;n &amp;#8212; seg&amp;#250;n el caso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Un &lt;i&gt;security-patch&lt;/i&gt; s&amp;#237; despliega (para eso existe). Un &lt;i&gt;bugfix&lt;/i&gt; o un &lt;i&gt;refactor&lt;/i&gt; no tocan operaci&amp;#243;n.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="884" y="1112" width="692" height="76" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n5" target="E-Bifurcacion_n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n6" target="E-Bifurcacion_n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n7" target="E-Bifurcacion_n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n8" target="E-Bifurcacion_n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n9" target="E-Bifurcacion_n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n10" target="E-Bifurcacion_n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n11" target="E-Bifurcacion_n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n13" target="E-Bifurcacion_n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n14" target="E-Bifurcacion_n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n15" target="E-Bifurcacion_n16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n16" target="E-Bifurcacion_n17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n17" target="E-Bifurcacion_n18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n18" target="E-Bifurcacion_n19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n19" target="E-Bifurcacion_n20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e35" value="sin c&amp;#243;digo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n2" target="E-Bifurcacion_n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_e36" value="con c&amp;#243;digo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E-Bifurcacion_n2" target="E-Bifurcacion_n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n37" value="&lt;b&gt;Las cinco diferencias reales, en una l&amp;#237;nea cada una&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1 &amp;#183; Ingenier&amp;#237;a inversa&lt;/b&gt; &amp;#8212; de cero se salta; sobre existente es lo primero que pasa, y produce nueve documentos que alimentan todo lo dem&amp;#225;s.&lt;br&gt;&lt;b&gt;2 &amp;#183; Las pr&amp;#225;cticas del equipo&lt;/b&gt; &amp;#8212; de cero te las pregunta; sobre existente las &lt;i&gt;descubre&lt;/i&gt; leyendo el repositorio. Es la misma etapa comport&amp;#225;ndose al rev&amp;#233;s.&lt;br&gt;&lt;b&gt;3 &amp;#183; La ideaci&amp;#243;n&lt;/b&gt; &amp;#8212; de cero es donde m&amp;#225;s valor tiene; sobre existente normalmente sobra.&lt;br&gt;&lt;b&gt;4 &amp;#183; El esqueleto que camina&lt;/b&gt; &amp;#8212; solo tiene sentido de cero. Sobre existente el camino ya est&amp;#225; probado.&lt;br&gt;&lt;b&gt;5 &amp;#183; El dise&amp;#241;o de dominio&lt;/b&gt; &amp;#8212; de cero modela todo; sobre existente se salta si solo modificas componentes que ya viven ah&amp;#237;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="1246" width="1540" height="180" as="geometry" /></mxCell><mxCell id="E-Bifurcacion_n38" value="&lt;b&gt;Un detalle que ahorra tiempo:&lt;/b&gt; la ingenier&amp;#237;a inversa &lt;b&gt;guarda lo que aprende&lt;/b&gt; por repositorio. Si vuelves a trabajar sobre el mismo c&amp;#243;digo, comprueba si el escaneo sigue vigente y te &lt;b&gt;ofrece reutilizarlo&lt;/b&gt; en vez de releerlo todo. Solo re-escanea si el almac&amp;#233;n est&amp;#225; obsoleto, sin verificar, o no cubre lo que esta vez necesitas." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="60" y="1446" width="1540" height="96" as="geometry" /></mxCell><mxCell id="p2_fr1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FCFCFC;strokeColor=#BBBBBB;dashed=1;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="40" y="118" width="1560" height="92" as="geometry" /></mxCell><mxCell id="p2_fr2" value="&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;&lt;b&gt;EL MODELO MENTAL DE AI-DLC&lt;/b&gt; &amp;#183; se repite en &lt;b&gt;cada&lt;/b&gt; actividad&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="122" width="496" height="16" as="geometry" /></mxCell><mxCell id="p2_fr3" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;planifica&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="52" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p2_fr4" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="164" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p2_fr5" value="&lt;span style=&quot;font-size:10px&quot;&gt;pregunta&lt;br&gt;por contexto&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#3D74AC;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="180" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p2_fr6" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="292" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p2_fr7" value="&lt;span style=&quot;font-size:10px&quot;&gt;T&amp;#218; VALIDAS&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=2;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="308" y="140" width="112" height="38" as="geometry" /></mxCell><mxCell id="p2_fr8" value="&lt;span style=&quot;font-size:13px;color:#666&quot;&gt;&amp;#8594;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;;aidlc-franja=1" vertex="1" parent="1"><mxGeometry x="420" y="140" width="16" height="38" as="geometry" /></mxCell><mxCell id="p2_fr9" value="&lt;span style=&quot;font-size:10px&quot;&gt;la IA&lt;br&gt;implementa&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#E8F