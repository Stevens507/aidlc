<mxfile host="app.diagrams.net" agent="aidlc-study" version="24.0.0" type="device"><diagram id="pg1" name="1 - El bucle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1-Bucle_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;El bucle de AI-DLC v2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;El motor decide &lt;b&gt;qu&amp;#233;&lt;/b&gt; hacer. El conductor decide &lt;b&gt;c&amp;#243;mo hacerlo bien&lt;/b&gt;. Una directiva por paso.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1140" height="66" as="geometry"/></mxCell><mxCell id="1-Bucle_n2" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;MOTOR &amp;#8212; c&amp;#243;digo determinista&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="360" height="930" as="geometry"/></mxCell><mxCell id="1-Bucle_n3" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;CONDUCTOR &amp;#8212; el LLM&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="430" y="130" width="360" height="930" as="geometry"/></mxCell><mxCell id="1-Bucle_n4" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;HUMANO&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="360" height="930" as="geometry"/></mxCell><mxCell id="1-Bucle_n5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Escribe &lt;code&gt;/aidlc&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;&amp;#171;construir el API de inventario&amp;#187;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;" vertex="1" parent="1"><mxGeometry x="850" y="200" width="300" height="96" as="geometry"/></mxCell><mxCell id="1-Bucle_n6" value="&lt;b style=&quot;font-size:13px&quot;&gt;Pasa los argumentos &lt;b&gt;verbatim&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;No los interpreta. El motor parsea las banderas.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="460" y="320" width="300" height="96" as="geometry"/></mxCell><mxCell id="1-Bucle_n7" value="&lt;b style=&quot;font-size:13px&quot;&gt;&lt;code&gt;next&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Lee &lt;i&gt;aidlc-state.md&lt;/i&gt; + &lt;i&gt;stage-graph.json&lt;/i&gt;.&lt;br&gt;Emite &lt;b&gt;una&lt;/b&gt; directiva. &lt;b&gt;No muta nada.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="300" height="96" as="geometry"/></mxCell><mxCell id="1-Bucle_n8" value="&lt;b style=&quot;font-size:13px&quot;&gt;Hace ese &amp;#250;nico movimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Cargar reglas &amp;#183; correr etapa &amp;#183; preguntar &amp;#183; imprimir&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="460" y="560" width="300" height="96" as="geometry"/></mxCell><mxCell id="1-Bucle_n9" value="&lt;b style=&quot;font-size:13px&quot;&gt;Responde en la compuerta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Aprobar &amp;#183; Pedir cambios&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;" vertex="1" parent="1"><mxGeometry x="850" y="680" width="300" height="96" as="geometry"/></mxCell><mxCell id="1-Bucle_n10" value="&lt;b style=&quot;font-size:13px&quot;&gt;&lt;code&gt;report&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Informa el resultado. Nunca escribe el estado &amp;#233;l mismo.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="460" y="800" width="300" height="96" as="geometry"/></mxCell><mxCell id="1-Bucle_n11" value="&lt;b style=&quot;font-size:13px&quot;&gt;Transici&amp;#243;n + auditor&amp;#237;a&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;At&amp;#243;micas: si falla la auditor&amp;#237;a, el estado &lt;b&gt;no&lt;/b&gt; se mueve.&lt;br&gt;Rutea a la siguiente etapa.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="70" y="920" width="300" height="96" as="geometry"/></mxCell><mxCell id="1-Bucle_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="1-Bucle_n5" target="1-Bucle_n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1-Bucle_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="1-Bucle_n6" target="1-Bucle_n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1-Bucle_e14" value="directiva" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="1-Bucle_n7" target="1-Bucle_n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1-Bucle_e15" value="si abre compuerta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="1-Bucle_n8" target="1-Bucle_n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1-Bucle_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="1-Bucle_n9" target="1-Bucle_n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1-Bucle_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="1-Bucle_n10" target="1-Bucle_n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1-Bucle_e18" value="repite hasta  done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#4A7EBB;dashed=1;" edge="1" parent="1" source="1-Bucle_n11" target="1-Bucle_n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1-Bucle_n19" value="&lt;b&gt;Los tres atajos que el dibujo simplifica&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;&lt;code&gt;load-steering&lt;/code&gt;&lt;/b&gt; &amp;#8212; antes de cada etapa el motor &lt;b&gt;lee del disco&lt;/b&gt; el texto de las reglas activas y se lo entrega al conductor. &amp;#201;ste lo aplica y llama a &lt;code&gt;continue&lt;/code&gt;, &lt;b&gt;sin&lt;/b&gt; &lt;code&gt;report&lt;/code&gt;. Se repite hasta que llega &lt;code&gt;run-stage&lt;/code&gt;.&lt;br&gt;&amp;#8226; &lt;b&gt;No toda directiva pasa por el humano&lt;/b&gt; &amp;#8212; las 3 etapas de arranque corren sin compuerta; un &lt;code&gt;print&lt;/code&gt; ejecuta y sigue; un &lt;code&gt;error&lt;/code&gt; imprime y &lt;b&gt;para&lt;/b&gt;.&lt;br&gt;&amp;#8226; &lt;b&gt;Ocho tipos de directiva&lt;/b&gt; se emiten hoy: &lt;code&gt;load-steering &amp;#183; run-stage &amp;#183; invoke-swarm &amp;#183; ask &amp;#183; print &amp;#183; error &amp;#183; done &amp;#183; parked&lt;/code&gt;. Otros dos (&lt;code&gt;dispatch-subagent&lt;/code&gt;, &lt;code&gt;present-gate&lt;/code&gt;) est&amp;#225;n declarados pero &lt;b&gt;no se emiten&lt;/b&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1140" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg2" name="2 - Que se activa en una etapa"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2-Etapa_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;Qu&amp;#233; se activa cuando corre &lt;i&gt;una&lt;/i&gt; etapa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Orden real de carga. Los pasos 1-6 ocurren &lt;b&gt;antes&lt;/b&gt; de que el LLM escriba una sola l&amp;#237;nea.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1240" height="66" as="geometry"/></mxCell><mxCell id="2-Etapa_n2" value="&lt;b style=&quot;font-size:13px&quot;&gt;1 &amp;#183; &lt;code&gt;load-steering&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;El motor &lt;b&gt;lee del disco&lt;/b&gt; org.md, team.md, project.md y la regla de fase.&lt;br&gt;Entrega el &lt;b&gt;texto&lt;/b&gt;, no la ruta. Se repite en cada etapa.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="340" y="180" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n3" value="&lt;b style=&quot;font-size:13px&quot;&gt;2 &amp;#183; &lt;code&gt;run-stage&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Llega &lt;b&gt;una&lt;/b&gt; directiva con &lt;b&gt;24 campos ya resueltos&lt;/b&gt;: rutas, reviewer, sensores, modo, siguiente etapa.&lt;br&gt;El conductor &lt;b&gt;nunca&lt;/b&gt; re-deriva una ruta.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="340" y="296" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n4" value="&lt;b style=&quot;font-size:13px&quot;&gt;3 &amp;#183; Persona + conocimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;&lt;b&gt;BLOQUEANTE&lt;/b&gt;: leer cada archivo de &lt;code&gt;inline_context_paths&lt;/code&gt; antes de nada m&amp;#225;s.&lt;br&gt;El nombre de un agente &lt;i&gt;no&lt;/i&gt; es contexto cargado.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="340" y="412" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n5" value="&lt;b style=&quot;font-size:13px&quot;&gt;4 &amp;#183; El archivo de etapa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Lee &lt;code&gt;stage_file&lt;/code&gt; &amp;#8212; los pasos concretos de esta etapa.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="340" y="528" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n6" value="&lt;b style=&quot;font-size:13px&quot;&gt;5 &amp;#183; Artefactos de entrada&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Lee &lt;code&gt;consumes&lt;/code&gt;: solo los que &lt;b&gt;existen en disco&lt;/b&gt;. Los ausentes van aparte, marcados si son esperados.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="340" y="644" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n7" value="&lt;b style=&quot;font-size:13px&quot;&gt;6 &amp;#183; Protocolos condicionales&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Lee &lt;code&gt;protocol_modules&lt;/code&gt;: reviewer, ensemble, construction, swarm, recovery, governance.&lt;br&gt;Solo los que aplican &amp;#8212; el resto no paga contexto.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="340" y="760" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n8" value="&lt;b style=&quot;font-size:13px&quot;&gt;7 &amp;#183; El cuerpo de la etapa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Preguntas al humano (Guide me / Editar archivo / Chat) &amp;#8594; artefactos.&lt;br&gt;Diario &lt;code&gt;memory.md&lt;/code&gt; en marcha.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="340" y="876" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n9" value="&lt;b style=&quot;font-size:13px&quot;&gt;8 &amp;#183; Reviewer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Si la etapa lo declara: sub-agente &lt;b&gt;separado&lt;/b&gt;. No ve el diario ni el plan del constructor.&lt;br&gt;Veredicto &lt;b&gt;READY&lt;/b&gt; / &lt;b&gt;NOT-READY&lt;/b&gt;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="340" y="992" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n10" value="&lt;b style=&quot;font-size:13px&quot;&gt;9 &amp;#183; Ritual de aprendizajes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Una herramienta lee el diario y aflora candidatos &lt;b&gt;verbatim&lt;/b&gt;. El humano elige qu&amp;#233; conservar.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="340" y="1108" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n11" value="&lt;b style=&quot;font-size:13px&quot;&gt;10 &amp;#183; Compuerta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;&lt;code&gt;report awaiting-approval&lt;/code&gt; &amp;#8594; Aprobar / Pedir cambios &amp;#8594; &lt;code&gt;report approved&lt;/code&gt;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E1D5E7;strokeColor=#8F6BA8;" vertex="1" parent="1"><mxGeometry x="340" y="1224" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_n12" value="&lt;b style=&quot;font-size:13px&quot;&gt;11 &amp;#183; El motor cierra&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Verifica que los artefactos existan, marca &lt;code&gt;[x]&lt;/code&gt;, emite auditor&amp;#237;a, rutea.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="340" y="1340" width="660" height="96" as="geometry"/></mxCell><mxCell id="2-Etapa_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n2" target="2-Etapa_n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n3" target="2-Etapa_n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n4" target="2-Etapa_n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n5" target="2-Etapa_n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n6" target="2-Etapa_n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n7" target="2-Etapa_n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n8" target="2-Etapa_n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n9" target="2-Etapa_n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n10" target="2-Etapa_n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="2-Etapa_n11" target="2-Etapa_n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2-Etapa_n23" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;CARGA&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="220" height="696" as="geometry"/></mxCell><mxCell id="2-Etapa_n24" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;EJECUCI&amp;#211;N&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="80" y="856" width="220" height="580" as="geometry"/></mxCell><mxCell id="2-Etapa_n25" value="&lt;b&gt;Nada de esto&lt;br&gt;lo decide el LLM.&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;El motor resuelve las rutas y se las entrega. Eso es lo que hace el flujo auditable: queda en la traza qu&amp;#233; se carg&amp;#243;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="200" height="676" as="geometry"/></mxCell><mxCell id="2-Etapa_n26" value="&lt;b&gt;Aqu&amp;#237; s&amp;#237;&lt;br&gt;trabaja el LLM.&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Y cada paso tiene su freno: el reviewer no ve el plan, el ritual aflora verbatim, la compuerta la cierra un humano.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1060" y="876" width="200" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg3" name="3 - Los 17 guardias"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3-Guardias_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;Los 17 guardias &amp;#8212; qu&amp;#233; vigila el framework y cu&amp;#225;ndo dispara&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Ninguno lo invoca el LLM. Los registra &lt;code&gt;settings.json&lt;/code&gt; y los ejecuta el harness. Por eso no se pueden saltar.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="66" as="geometry"/></mxCell><mxCell id="3-Guardias_n2" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;PreToolUse &amp;#8212; ANTES de que la herramienta corra&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="700" height="428" as="geometry"/></mxCell><mxCell id="3-Guardias_n3" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-deliver-stage-rules&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;i&gt;Task | Agent&lt;/i&gt; &amp;#8212; pega el paquete exacto de reglas en el brief de cada sub-agente&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="174" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n4" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-state-transition-guard&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;rechaza que el LLM escriba el estado por su cuenta&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="236" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n5" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-reviewer-scope&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;impide que el reviewer lea fuera de su alcance&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="298" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n6" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-review-freeze&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;congela el artefacto tras el recibo terminal: tocarlo invalida la revisi&amp;#243;n&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="360" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n7" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-plan-approval-guard&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;i&gt;Task&lt;/i&gt; &amp;#8212; bloquea generar c&amp;#243;digo sin Plan Approval del humano&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="422" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n8" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-fold-usage&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;contabiliza tokens y coste&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="484" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n9" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;PostToolUse &amp;#8212; DESPU&amp;#201;S de que la herramienta corra&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="586" width="700" height="428" as="geometry"/></mxCell><mxCell id="3-Guardias_n10" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-write-audit-log&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;i&gt;Write | Edit&lt;/i&gt; &amp;#8212; emite ARTIFACT_CREATED / ARTIFACT_UPDATED&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="630" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n11" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-run-sensors&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;i&gt;Write | Edit&lt;/i&gt; &amp;#8212; dispara los sensores que apliquen al archivo escrito&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="692" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n12" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-sync-workflow-state&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;i&gt;TaskUpdate&lt;/i&gt; &amp;#8212; sincroniza la etapa actual&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="754" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n13" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-record-human-turn&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;i&gt;AskUserQuestion&lt;/i&gt; &amp;#8212; deja constancia de que hubo un humano&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="816" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n14" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-rebuild-stage-graph&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;i&gt;Bash&lt;/i&gt; &amp;#8212; recompila el grafo de runtime tras cada transici&amp;#243;n&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="878" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n15" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;aidlc-fold-usage&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;cierre del conteo de tokens&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="84" y="940" width="652" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n16" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;Un guardia por evento&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="740" height="490" as="geometry"/></mxCell><mxCell id="3-Guardias_n17" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;UserPromptSubmit&lt;/b&gt; &amp;#8594; &lt;code&gt;aidlc-record-human-turn&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;registra HUMAN_TURN &amp;#8212; la prueba de que hubo persona&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="824" y="174" width="692" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n18" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;SessionStart&lt;/b&gt; &amp;#8594; &lt;code&gt;aidlc-session-start&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;emite SESSION_STARTED / RESUMED e inyecta contexto al reanudar&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="824" y="236" width="692" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n19" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;SessionEnd&lt;/b&gt; &amp;#8594; &lt;code&gt;aidlc-session-end&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;emite SESSION_ENDED&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="824" y="298" width="692" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n20" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;PreCompact&lt;/b&gt; &amp;#8594; &lt;code&gt;aidlc-validate-state&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;valida el estado y deja la miga de recuperaci&amp;#243;n antes de compactar&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="824" y="360" width="692" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n21" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;SubagentStop&lt;/b&gt; &amp;#8594; &lt;code&gt;aidlc-log-subagent&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;emite SUBAGENT_COMPLETED&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="824" y="422" width="692" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n22" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Stop&lt;/b&gt; &amp;#8594; &lt;code&gt;aidlc-continue-workflow&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;b&gt;hace cumplir el bucle&lt;/b&gt;: si el turno termina a medias, lo devuelve&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="824" y="484" width="692" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n23" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;b&gt;statusLine&lt;/b&gt; &amp;#8594; &lt;code&gt;aidlc-statusline&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;muestra la posici&amp;#243;n del workflow en la terminal&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D6912B;" vertex="1" parent="1"><mxGeometry x="824" y="546" width="692" height="52" as="geometry"/></mxCell><mxCell id="3-Guardias_n24" value="&lt;b&gt;Por qu&amp;#233; esto importa m&amp;#225;s de lo que parece&lt;/b&gt;&lt;br&gt;&lt;br&gt;La CLI de auditor&amp;#237;a &lt;b&gt;rechaza&lt;/b&gt; que nadie escriba a mano los eventos que portan autoridad: &lt;code&gt;HUMAN_TURN&lt;/code&gt;, &lt;code&gt;GATE_APPROVED&lt;/code&gt;, &lt;code&gt;REVIEW_COMPLETED&lt;/code&gt;, &lt;code&gt;AUTONOMY_MODE_SET&lt;/code&gt; y los cuatro &lt;code&gt;UNIT_*&lt;/code&gt;.&lt;br&gt;&lt;br&gt;Son exactamente los que las guardas del motor leen como &lt;b&gt;evidencia de autorizaci&amp;#243;n&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Un LLM no puede fabricar su propio permiso.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="740" height="216" as="geometry"/></mxCell><mxCell id="3-Guardias_n25" value="&lt;b&gt;Lo que estos 17 revelan del dise&amp;#241;o&lt;/b&gt;&lt;br&gt;Cada guardia existe porque un LLM se salta el paso que vigila. No son defensa en abstracto: &lt;code&gt;plan-approval-guard&lt;/code&gt; existe porque un agente empieza a generar sin esperar; &lt;code&gt;state-transition-guard&lt;/code&gt; porque escribe el estado por su cuenta; &lt;code&gt;continue-workflow&lt;/code&gt; porque abandona el bucle a medio turno.&lt;br&gt;&lt;b&gt;La complejidad de esta p&amp;#225;gina est&amp;#225; comprada con fallos reales.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="1042" width="1480" height="116" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg4" name="4 - Las 262 piezas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4-Piezas_n1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;Las 262 piezas que se instalan &amp;#8212; y qu&amp;#233; hace cada grupo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;191 archivos &lt;b&gt;.md&lt;/b&gt; (datos que el motor lee) &amp;#183; 58 &lt;b&gt;.ts&lt;/b&gt; (~64.800 l&amp;#237;neas) &amp;#183; 7 &lt;b&gt;.json&lt;/b&gt; (lo compilado)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="66" as="geometry"/></mxCell><mxCell id="4-Piezas_n2" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;DATOS &amp;#8212; 191 archivos .md&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="480" height="672" as="geometry"/></mxCell><mxCell id="4-Piezas_n3" value="&lt;b style=&quot;font-size:12px&quot;&gt;33 etapas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;code&gt;aidlc-common/stages/&lt;/code&gt; en 5 fases. Cada una declara qu&amp;#233; consume, qu&amp;#233; produce, qu&amp;#233; sensores y qu&amp;#233; reviewer.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="82" y="174" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n4" value="&lt;b style=&quot;font-size:12px&quot;&gt;14 agentes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;11 expertos de dominio + 2 revisores + 1 composer. Todos con &lt;code&gt;disallowedTools: Task&lt;/code&gt;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="82" y="262" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n5" value="&lt;b style=&quot;font-size:12px&quot;&gt;11 scopes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;De &lt;code&gt;bugfix&lt;/code&gt; (7 etapas) a &lt;code&gt;enterprise&lt;/code&gt; (33).&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="82" y="350" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n6" value="&lt;b style=&quot;font-size:12px&quot;&gt;59 de conocimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Metodolog&amp;#237;a por agente, m&amp;#225;s 9 compartidos.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="82" y="438" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n7" value="&lt;b style=&quot;font-size:12px&quot;&gt;7 protocolos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Se cargan &lt;b&gt;solo si aplican&lt;/b&gt;: reviewer, ensemble, construction, swarm, recovery, governance.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="82" y="526" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n8" value="&lt;b style=&quot;font-size:12px&quot;&gt;6 sensores&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Manifiestos de verificaci&amp;#243;n determinista.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="82" y="614" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n9" value="&lt;b style=&quot;font-size:12px&quot;&gt;43 skills&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;El conductor &lt;code&gt;SKILL.md&lt;/code&gt; m&amp;#225;s los runners generados.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="82" y="702" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n10" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;C&amp;#211;DIGO &amp;#8212; 58 archivos .ts&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="480" height="408" as="geometry"/></mxCell><mxCell id="4-Piezas_n11" value="&lt;b style=&quot;font-size:12px&quot;&gt;41 herramientas CLI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;b&gt;Motor 47%&lt;/b&gt;: 27.590 l&amp;#237;neas en 8 archivos. &lt;b&gt;Periferia 53%&lt;/b&gt;: 30.586 en 33.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="582" y="174" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n12" value="&lt;b style=&quot;font-size:12px&quot;&gt;17 hooks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;6.617 l&amp;#237;neas. Son los guardias de la p&amp;#225;gina 3.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="582" y="262" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n13" value="&lt;b style=&quot;font-size:12px&quot;&gt;Los cuatro grandes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;code&gt;aidlc-lib&lt;/code&gt; 9.991 &amp;#183; &lt;code&gt;aidlc-utility&lt;/code&gt; 6.108 &amp;#183; &lt;code&gt;aidlc-orchestrate&lt;/code&gt; 6.100 &amp;#183; &lt;code&gt;aidlc-state&lt;/code&gt; 4.162&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="582" y="350" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n14" value="&lt;b style=&quot;font-size:12px&quot;&gt;Todo corre en &lt;b&gt;bun&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Dependencia dura. En Windows debe estar en el PATH de las shells &lt;b&gt;no interactivas&lt;/b&gt;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#DAE8FC;strokeColor=#4A7EBB;" vertex="1" parent="1"><mxGeometry x="582" y="438" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n15" value="&lt;b style=&quot;font-size:14px;color:#555&quot;&gt;COMPILADO &amp;#8212; 7 archivos .json&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FAFAFA;strokeColor=#CCCCCC;dashed=1;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="480" height="408" as="geometry"/></mxCell><mxCell id="4-Piezas_n16" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;stage-graph.json&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;&lt;b&gt;Viene ya compilado en el dist.&lt;/b&gt; 33 nodos con reglas y sensores &lt;b&gt;ya resueltos por etapa&lt;/b&gt;.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="1082" y="174" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n17" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;scope-grid.json&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;La transpuesta: qu&amp;#233; etapa corre en qu&amp;#233; scope.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="1082" y="262" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n18" value="&lt;b style=&quot;font-size:12px&quot;&gt;&lt;code&gt;harness.json&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Qu&amp;#233; harness es y qu&amp;#233; plugins est&amp;#225;n activos.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="1082" y="350" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n19" value="&lt;b style=&quot;font-size:12px&quot;&gt;Se recompila&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Solo al cambiar la selecci&amp;#243;n de plugins. &lt;b&gt;No&lt;/b&gt; en cada workflow.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#D5E8D4;strokeColor=#5E9E52;" vertex="1" parent="1"><mxGeometry x="1082" y="438" width="436" height="76" as="geometry"/></mxCell><mxCell id="4-Piezas_n20" value="&lt;b&gt;Construido para un futuro que a&amp;#250;n no llega&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Siete abstracciones declaradas en el esquema, todas con &lt;b&gt;cero&lt;/b&gt; usos hoy.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&amp;#183; &lt;code&gt;mode: agent-team&lt;/code&gt; &amp;#8212; quinto modo de ejecuci&amp;#243;n; ninguna etapa lo usa&lt;br&gt;&amp;#183; &lt;code&gt;dispatch-subagent&lt;/code&gt; y &lt;code&gt;present-gate&lt;/code&gt; &amp;#8212; 2 de las 10 directivas, nunca se emiten&lt;br&gt;&amp;#183; &lt;code&gt;kind: llm&lt;/code&gt; en sensores &amp;#8212; reservado para v0.11+&lt;br&gt;&amp;#183; &lt;code&gt;default_severity: blocking&lt;/code&gt; &amp;#8212; reservado (#431). &lt;b&gt;Por eso hoy ning&amp;#250;n sensor bloquea nada.&lt;/b&gt;&lt;br&gt;&amp;#183; reglas por etapa &amp;#8212; la quinta capa de la cadena, sin construir&lt;br&gt;&amp;#183; campo &lt;code&gt;bundle&lt;/code&gt; &amp;#8212; &amp;#171;deliberadamente sin usar&amp;#187;&lt;br&gt;&amp;#183; predicado &lt;code&gt;when:&lt;/code&gt; &amp;#8212; se parsea, ning&amp;#250;n consumidor lo eval&amp;#250;a" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="60" y="810" width="960" height="258" as="geometry"/></mxCell><mxCell id="4-Piezas_n21" value="&lt;b&gt;La proporci&amp;#243;n que m&amp;#225;s dice&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;64.800&lt;/b&gt; l&amp;#237;neas de c&amp;#243;digo&lt;br&gt;&lt;b&gt;24.700&lt;/b&gt; l&amp;#237;neas de documentaci&amp;#243;n para explicarlo&lt;br&gt;&lt;br&gt;Una l&amp;#237;nea de documentaci&amp;#243;n por cada 2,6 de c&amp;#243;digo.&lt;br&gt;&lt;br&gt;Corta en los dos sentidos: o el sistema est&amp;#225; excepcionalmente bien documentado, o necesita esa cantidad de explicaci&amp;#243;n para poder usarse.&lt;br&gt;&lt;br&gt;&lt;b&gt;Probablemente las dos cosas.&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1060" y="810" width="480" height="258" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>