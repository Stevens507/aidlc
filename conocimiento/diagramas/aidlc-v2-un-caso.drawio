        <mxCell id="Caso_n10" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=3;align=center;verticalAlign=top;spacingTop=14;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:32px;color:#B85450&quot;&gt;4&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;color:#444&quot;&gt;SE CONSTRUYE CON FRENOS&lt;/b&gt;&lt;/div&gt;" vertex="1">
