        <mxCell id="Caso_n11" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F7F7F7;strokeColor=#BBBBBB;dashed=1;align=center;verticalAlign=middle;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;&lt;b&gt;fase 3 &amp;#183; construcci&amp;#243;n&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#666&quot;&gt;paper: &lt;b&gt;Construction&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
