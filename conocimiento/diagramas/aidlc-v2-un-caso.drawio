        <mxCell id="Caso_n12" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4C9A45;strokeWidth=3;align=center;verticalAlign=top;spacingTop=14;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:32px;color:#4C9A45&quot;&gt;5&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;color:#444&quot;&gt;QUEDA EL RASTRO&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="150" x="60" y="1796" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n13" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F7F7F7;strokeColor=#BBBBBB;dashed=1;align=center;verticalAlign=middle;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;&lt;b&gt;fase 4 &amp;#183; operaci&amp;#243;n&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#666&quot;&gt;paper: &lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color:#888&#39;&gt;el rastro viene&lt;br&gt;acumulando desde el 0&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="58" width="134" x="68" y="1926" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n14" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F0F0F0;strokeColor=#8A8A8A;shadow=1;" value="" vertex="1">
          <mxGeometry height="250" width="250" x="240" y="256" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n16" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Quien recibe el encargo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;Desarrolladora del equipo,&lt;br&gt;con el CRM abierto&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="78" width="230" x="250" y="418" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n17" parent="1" style="shape=callout;perimeter=calloutPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9821F;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;fontFamily=Helvetica;position=0.12;shadow=1;" value="&lt;b style=&quot;font-size:13px&quot;&gt;&amp;#171;Los clientes acumulan puntos por compra pero lo llevamos en una hoja de c&amp;#225;lculo. Necesitamos que el CRM lo haga solo: que acumule, que canjee, y que el vendedor vea el saldo cuando atiende.&amp;#187;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666&quot;&gt;&amp;#8212; la petici&amp;#243;n, tal como llega&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="620" x="515" y="256" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n18" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#F0F0F0;strokeColor=#8A8A8A;" value="&lt;b style=&quot;font-size:12px&quot;&gt;LO QUE YA EXISTE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CRM retail en producci&amp;#243;n: clientes, ventas, inventario, campa&amp;#241;as. Lo usa la fuerza de ventas todos los d&amp;#237;as.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="300" x="515" y="426" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n19" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FBE3E2;strokeColor=#B85450;" value="&lt;b style=&quot;font-size:12px&quot;&gt;LO QUE FALTA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;El m&amp;#243;dulo de fidelizaci&amp;#243;n. Toca clientes y ventas &amp;#8212; dos m&amp;#243;dulos que ya funcionan.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="300" x="835" y="426" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n20" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=3;shadow=1;" value="&lt;b&gt;Lo &amp;#250;nico que se escribe para arrancar&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:12px&quot;&gt;/aidlc &amp;#171;a&amp;#241;adir un m&amp;#243;dulo de fidelizaci&amp;#243;n por puntos al CRM: acumulaci&amp;#243;n, canje y consulta de saldo&amp;#187;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#444&quot;&gt;No hace falta especificaci&amp;#243;n previa, ni plantilla, ni ticket. La frase en lenguaje natural es la entrada.&lt;/span&gt;" vertex="1">
          <mxGeometry height="250" width="560" x="1160" y="256" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n21" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E8F1FB;strokeColor=#3D74AC;spacingTop=42;" value="&lt;b style=&quot;font-size:12px&quot;&gt;Escanea el directorio&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Encuentra c&amp;#243;digo fuente, manifiesto con dependencias, carpetas de aplicaci&amp;#243;n.&lt;br&gt;&lt;br&gt;&lt;b&gt;Veredicto: hay c&amp;#243;digo corriendo.&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="240" width="260" x="240" y="526" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n22" parent="1" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/carbon-pictograms/1/Magnify.svg;" value="" vertex="1">
          <mxGeometry height="70" width="70" x="410" y="538" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n23" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E8F1FB;strokeColor=#3D74AC;" value="&lt;b style=&quot;font-size:12px&quot;&gt;Elige el camino&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;M&amp;#243;dulo nuevo sobre sistema existente, de cara al usuario, con reglas de negocio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Camino: feature&lt;/b&gt;&lt;br&gt;Profundidad est&amp;#225;ndar&lt;br&gt;&lt;b&gt;Se activan las seis salvaguardas&lt;/b&gt; por haber c&amp;#243;digo.&lt;/span&gt;" vertex="1">
          <mxGeometry height="240" width="300" x="525" y="526" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n24" parent="1" style="shape=callout;perimeter=calloutPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D74AC;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;fontFamily=Helvetica;position=0.12;shadow=1;" value="&lt;b style=&quot;font-size:13px&quot;&gt;&amp;#171;Iniciando un flujo &amp;#171;feature&amp;#187; para: a&amp;#241;adir m&amp;#243;dulo de fidelizaci&amp;#243;n &amp;#8212; 33 de 33 etapas, 29 compuertas de aprobaci&amp;#243;n, 5 etapas se repiten por unidad de trabajo. Confirma, nombra otro camino, o di compose.&amp;#187;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666&quot;&gt;&amp;#8212; los n&amp;#250;meros son &lt;b&gt;contados del grafo&lt;/b&gt;, no estimados. Aparecen &lt;b&gt;antes&lt;/b&gt; de empezar.&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="620" x="850" y="526" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n25" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=3;shadow=1;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Ella decide&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Ve 29 compuertas y le parece mucho para un m&amp;#243;dulo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Responde: &amp;#171;compose&amp;#187;&lt;/b&gt;&lt;br&gt;&lt;br&gt;El sistema propone un plan a medida: &lt;b&gt;21 etapas&lt;/b&gt;, con la raz&amp;#243;n de cada una que entra &lt;i&gt;y de cada una que descarta&lt;/i&gt;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="230" x="1490" y="526" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n26" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E8F1FB;strokeColor=#3D74AC;" value="" vertex="1">
          <mxGeometry height="330" width="200" x="240" y="786" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n27" parent="1" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/carbon-pictograms/1/Dialogue.svg;" value="" vertex="1">
          <mxGeometry height="110" width="110" x="285" y="806" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n28" parent="1" style="text;html=1;align=center;verticalAlign=top;fontFamily=Helvetica;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Antes de escribir&lt;br&gt;nada, pregunta&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Revisa seis dimensiones y&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;detecta qué no sabe.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="180" x="250" y="926" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n29" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#3D74AC;verticalAlign=middle;" value="&lt;span style=&quot;font-size:12px&quot;&gt;&amp;#191;Los puntos &lt;b&gt;caducan&lt;/b&gt;? &amp;#191;A los cu&amp;#225;ntos meses?&lt;/span&gt;" vertex="1">
          <mxGeometry height="52" width="480" x="460" y="796" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n30" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#3D74AC;verticalAlign=middle;" value="&lt;span style=&quot;font-size:12px&quot;&gt;&amp;#191;El canje es &lt;b&gt;total o parcial&lt;/b&gt; sobre el importe?&lt;/span&gt;" vertex="1">
          <mxGeometry height="52" width="480" x="460" y="858" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n31" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#3D74AC;verticalAlign=middle;" value="&lt;span style=&quot;font-size:12px&quot;&gt;&amp;#191;Qui&amp;#233;n puede &lt;b&gt;ajustar&lt;/b&gt; puntos a mano, y queda registro?&lt;/span&gt;" vertex="1">
          <mxGeometry height="52" width="480" x="460" y="920" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n32" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#3D74AC;verticalAlign=middle;" value="&lt;span style=&quot;font-size:12px&quot;&gt;&amp;#191;Qu&amp;#233; pasa con los puntos si &lt;b&gt;se devuelve&lt;/b&gt; la compra?&lt;/span&gt;" vertex="1">
          <mxGeometry height="52" width="480" x="460" y="982" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n33" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FBE3E2;strokeColor=#B85450;verticalAlign=middle;dashed=1;" value="&lt;span style=&quot;font-size:10px;color:#B85450&quot;&gt;&lt;b&gt;Nota:&lt;/b&gt; el framework dice &amp;#171;genera preguntas aclaratorias&amp;#187;, no cu&amp;#225;les. Estas son plausibles, &lt;b&gt;no est&amp;#225;n escritas en el repositorio&lt;/b&gt;.&lt;/span&gt;" vertex="1">
          <mxGeometry height="58" width="480" x="460" y="1052" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n34" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF0DB;strokeColor=#C9821F;" value="&lt;b style=&quot;font-size:12px&quot;&gt;Ella elige c&amp;#243;mo responder&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Gu&amp;#237;ame&lt;/b&gt; &amp;#8212; una a una&lt;br&gt;&lt;br&gt;&lt;b&gt;Yo edito el archivo&lt;/b&gt; &amp;#8212; por escrito&lt;br&gt;&lt;br&gt;&lt;b&gt;Conversemos&lt;/b&gt; &amp;#8212; suelto&lt;br&gt;&lt;br&gt;En los tres, &lt;b&gt;el archivo es el registro&lt;/b&gt;.&lt;/span&gt;" vertex="1">
          <mxGeometry height="200" width="250" x="965" y="786" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n35" parent="1" style="shape=callout;perimeter=calloutPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D74AC;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;fontFamily=Helvetica;position=0.12;shadow=1;" value="&lt;b style=&quot;font-size:13px&quot;&gt;&amp;#171;Dijiste que el canje es total, pero antes dijiste que el vendedor puede aplicar puntos parciales en caja. Son incompatibles. &amp;#191;Cu&amp;#225;l manda?&amp;#187;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666&quot;&gt;&amp;#8212; detecci&amp;#243;n de contradicci&amp;#243;n. &lt;b&gt;No avanza hasta resolverla.&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="200" width="480" x="1240" y="786" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n36" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" value="&lt;b&gt;Y una regla que est&amp;#225; escrita, literal, en el protocolo:&lt;/b&gt; &lt;i&gt;&amp;#171;por defecto preguntar, no asumir; nunca proceder con ambig&amp;#252;edad&amp;#187;&lt;/i&gt;. Si ella respondiera &amp;#171;lo que t&amp;#250; creas&amp;#187;, le repregunta: &lt;i&gt;&amp;#171;quiero asegurarme de que el dise&amp;#241;o refleje TUS prioridades&amp;#187;&lt;/i&gt;." vertex="1">
          <mxGeometry height="104" width="755" x="965" y="1006" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n37" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E4F3E4;strokeColor=#4C9A45;spacingTop=40;" value="&lt;b style=&quot;font-size:12px&quot;&gt;Sale el artefacto&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;b&gt;requirements.md&lt;/b&gt;&lt;br&gt;&amp;#183; acumulaci&amp;#243;n: 1 punto por cada 10 de compra&lt;br&gt;&amp;#183; caducidad a 12 meses&lt;br&gt;&amp;#183; canje parcial autorizado por supervisor&lt;br&gt;&amp;#183; la devoluci&amp;#243;n revierte los puntos&lt;br&gt;&amp;#183; el saldo se ve en la ficha del cliente&lt;/span&gt;" vertex="1">
          <mxGeometry height="290" width="340" x="240" y="1136" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n38" parent="1" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/carbon-pictograms/1/Idea.svg;" value="" vertex="1">
          <mxGeometry height="60" width="60" x="380" y="1148" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n39" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E8F1FB;strokeColor=#3D74AC;" value="" vertex="1">
          <mxGeometry height="290" width="300" x="605" y="1136" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n40" parent="1" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/carbon-pictograms/1/Advocate.svg;" value="" vertex="1">
          <mxGeometry height="110" width="110" x="700" y="1154" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n41" parent="1" style="text;html=1;align=center;verticalAlign=top;fontFamily=Helvetica;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Un revisor independiente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Otro rol, que &lt;b&gt;no vio cómo se hizo&lt;/b&gt;. Recibe los artefactos,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&amp;nbsp;no el diario ni el plan. Intenta &lt;b&gt;refutarlo&lt;/b&gt;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="280" x="615" y="1274" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n42" parent="1" style="shape=callout;perimeter=calloutPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D74AC;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;fontFamily=Helvetica;position=0.12;shadow=1;" value="&lt;b style=&quot;font-size:13px&quot;&gt;NO LISTO &amp;#8212; &amp;#171;No dice qu&amp;#233; pasa si el cliente devuelve una compra &lt;b&gt;despu&amp;#233;s&lt;/b&gt; de haber canjeado esos puntos. Saldo negativo sin regla.&amp;#187;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666&quot;&gt;&amp;#8212; LISTO es el veredicto al que &lt;b&gt;falla en llegar&lt;/b&gt;, no el punto de partida.&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="930" y="1136" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n43" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E8F1FB;strokeColor=#3D74AC;" value="&lt;b style=&quot;font-size:12px&quot;&gt;Se repara y se vuelve a revisar&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Se a&amp;#241;ade la regla del saldo negativo. Segundo intento: &lt;b&gt;LISTO&lt;/b&gt;.&lt;br&gt;M&amp;#225;ximo dos vueltas; si sigue sin cerrar, se llega a la compuerta con el hallazgo anotado.&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="480" x="930" y="1296" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n44" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=3;shadow=1;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;LA COMPUERTA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Ella lee, y elige:&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Aprobar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;contin&amp;#250;a a Historias de usuario&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Pedir cambios&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#444&quot;&gt;Nada avanza sin esto.&lt;br&gt;Y si pide cambios tres veces, en la cuarta aparece &lt;b&gt;&amp;#171;acepta como est&amp;#225;&amp;#187;&lt;/b&gt;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="285" x="1435" y="1136" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n45" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FBE3E2;strokeColor=#B85450;spacingTop=40;" value="&lt;b style=&quot;font-size:12px&quot;&gt;Radio de impacto&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Antes de tocar nada, mira &lt;b&gt;qu&amp;#233; del CRM se ve afectado&lt;/b&gt;:&lt;br&gt;&lt;br&gt;&amp;#183; m&amp;#243;dulo de ventas &amp;#8212; hay que enganchar el c&amp;#225;lculo&lt;br&gt;&amp;#183; ficha de cliente &amp;#8212; nueva secci&amp;#243;n de saldo&lt;br&gt;&amp;#183; devoluciones &amp;#8212; toca revertir puntos&lt;br&gt;&lt;br&gt;&lt;b&gt;Impacto: alto.&lt;/b&gt; Es transversal.&lt;br&gt;Se lo presenta a ella &lt;b&gt;antes&lt;/b&gt; de proceder.&lt;/span&gt;" vertex="1">
          <mxGeometry height="330" width="340" x="240" y="1446" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n46" parent="1" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/font-awesome/1/Magnifying_Glass.svg;" value="" vertex="1">
          <mxGeometry height="60" width="60" x="380" y="1458" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n47" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FBE3E2;strokeColor=#B85450;" value="&lt;b style=&quot;font-size:12px&quot;&gt;L&amp;#237;nea base de pruebas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Corre la suite del CRM &lt;b&gt;antes de tocar nada&lt;/b&gt;:&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;847 pruebas &amp;#183; 841 pasan &amp;#183; 6 saltadas &amp;#183; 73% cobertura&lt;/span&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="605" y="1446" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n48" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FBE3E2;strokeColor=#B85450;" value="&lt;b style=&quot;font-size:12px&quot;&gt;Validaci&amp;#243;n despu&amp;#233;s&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;863 pruebas &amp;#183; 861 pasan &amp;#183; 2 fallan&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Esas 2 son regresiones del cambio.&lt;/b&gt; Se arreglan antes de seguir.&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="605" y="1616" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n49" parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=30;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=12;fontFamily=Helvetica;fillColor=#FBE3E2;strokeColor=#B85450;strokeWidth=4;shadow=1;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;PARADA DURA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666&quot;&gt;antes de escribir una sola l&amp;#237;nea de c&amp;#243;digo&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Se presenta el plan y las instrucciones de prueba, con una &lt;b&gt;huella criptogr&amp;#225;fica&lt;/b&gt;:&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:10px&quot;&gt;sha256:4f2a9c...&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Cualquier cambio posterior la invalida&lt;/b&gt; y hay que volver a aprobar.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="480" x="930" y="1446" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n50" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF9E6;strokeColor=#D6B656;" value="&lt;b&gt;Del texto de la etapa, literal:&lt;/b&gt; &lt;i&gt;&amp;#171;no infieras la aprobaci&amp;#243;n de una continuaci&amp;#243;n del bucle. Solo un &amp;#171;apruebo el plan&amp;#187; expl&amp;#237;cito autoriza generar desde los archivos exactamente firmados.&amp;#187;&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="480" x="930" y="1656" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n51" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E8F1FB;strokeColor=#3D74AC;" value="" vertex="1">
          <mxGeometry height="330" width="285" x="1435" y="1446" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n52" parent="1" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/carbon-pictograms/1/Code_Syntax.svg;" value="" vertex="1">
          <mxGeometry height="95" width="95" x="1530" y="1466" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n53" parent="1" style="text;html=1;align=center;verticalAlign=top;fontFamily=Helvetica;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Y recién entonces,&lt;br&gt;se genera el código&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Unidad por unidad, con sus pruebas.&lt;br&gt;&lt;br&gt;El primer Bolt no lleva esqueleto: &lt;b&gt;el CRM ya camina&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Si un Bolt falla: se detiene, se conservan los&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:11px&quot;&gt;que sí salieron, y le preguntan.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="195" width="265" x="1445" y="1571" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n54" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E4F3E4;strokeColor=#4C9A45;" value="" vertex="1">
          <mxGeometry height="260" width="230" x="240" y="1796" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n55" parent="1" style="shape=image;html=1;imageAspect=0;aspect=fixed;labelBackgroundColor=none;image=https://icons.diagrams.net/assets/carbon-pictograms/1/Audit_Trail.svg;" value="" vertex="1">
          <mxGeometry height="100" width="100" x="305" y="1816" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n56" parent="1" style="text;html=1;align=center;verticalAlign=top;fontFamily=Helvetica;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Lo que queda en disco&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="210" x="250" y="1926" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n57" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E4F3E4;strokeColor=#4C9A45;" value="&lt;b style=&quot;font-size:12px&quot;&gt;El expediente del caso&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&amp;#183; requisitos, historias y criterios de aceptaci&amp;#243;n&lt;br&gt;&amp;#183; el modelo de dominio con sus decisiones&lt;br&gt;&amp;#183; el radio de impacto y la l&amp;#237;nea base&lt;br&gt;&amp;#183; el plan aprobado con su huella&lt;br&gt;&amp;#183; el c&amp;#243;digo con sus pruebas&lt;br&gt;&amp;#183; &lt;b&gt;el rastro de auditor&amp;#237;a completo&lt;/b&gt;: qui&amp;#233;n aprob&amp;#243; qu&amp;#233; y cu&amp;#225;ndo&lt;/span&gt;" vertex="1">
          <mxGeometry height="260" width="410" x="495" y="1796" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n58" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#E4F3E4;strokeColor=#4C9A45;" value="&lt;b style=&quot;font-size:12px&quot;&gt;La cadena que se puede recorrer&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;FR3 &amp;#171;los puntos caducan a 12 meses&amp;#187;&lt;br&gt;&amp;#160;&amp;#160;&amp;#8594; US2.1 &amp;#171;como cliente quiero ver&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;cu&amp;#225;ndo vencen mis puntos&amp;#187;&lt;br&gt;&amp;#160;&amp;#160;&amp;#8594; AC2.1.3 criterio de aceptaci&amp;#243;n&lt;br&gt;&amp;#160;&amp;#160;&amp;#8594; BR1.4 regla de negocio&lt;br&gt;&amp;#160;&amp;#160;&amp;#8594; U2 unidad de trabajo&lt;br&gt;&amp;#160;&amp;#160;&amp;#8594; el archivo y su prueba&lt;/span&gt;" vertex="1">
          <mxGeometry height="260" width="480" x="930" y="1796" as="geometry" />
        </mxCell>
        <mxCell id="Caso_n59" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fillColor=#FFF0DB;strokeColor=#C9821F;strokeWidth=3;shadow=1;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Y por eso puede&lt;br&gt;responderle al auditor&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&amp;#171;&amp;#191;De d&amp;#243;nde sali&amp;#243; esta regla de caducidad?&amp;#187;&lt;br&gt;&lt;br&gt;&lt;b&gt;Del requisito FR3, aprobado el 12 de marzo, tras un hallazgo del revisor.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#B85450;font-size:10px&quot;&gt;Con un l&amp;#237;mite: la cadena llega al despliegue, pero &lt;b&gt;no hay vuelta atr&amp;#225;s desde un commit&lt;/b&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="285" x="1435" y="1796" as="geometry" />
        </mxCell>
